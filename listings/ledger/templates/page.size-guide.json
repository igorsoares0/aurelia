      "settings": {
        "color_scheme": "ground",
        "heading": "The four forms",
        "table_caption": "Forms compared on diameter, height, capacity and weight",
        "note": "<p>Thrown by hand, so read these as within about five millimetres either way. Every product page carries the measured dimensions of the actual piece you are buying.</p>"
      }
    },
    "questions": {
      "type": "collapsible-content",
      "blocks": {
        "q1": {
          "type": "row",
          "settings": {
            "heading": "Why is mine a few millimetres off?",
            "text": "<p>Because it was thrown on a wheel and then fired, and stoneware shrinks about twelve per cent in the kiln. The number on the product page is the piece, measured after firing.</p>"
          }
        },
        "q2": {
          "type": "row",
          "settings": {
            "heading": "Will a new bowl stack with an older one?",
            "text": "<p>Within a form, yes. Across firings the wall thickness varies slightly, so four deep is safe and six is optimistic.</p>"
          }
        },
        "q3": {
          "type": "row",
          "settings": {
            "heading": "Do the cups fit a standard saucer?",
            "text": "<p>The 8.5 cm cup sits on our dinner plate and on most saucers. It was not designed to a standard, and we would rather say so.</p>"
          }
        },
        "q4": {
          "type": "row",
          "settings": {
            "heading": "Are the dimensions on the product page exact?",
            "text": "<p>Yes — each piece is measured after it comes out of the kiln, not taken from a sample. That is why two of the same form can list different numbers.</p>"
          }
        }
      },
      "block_order": [
