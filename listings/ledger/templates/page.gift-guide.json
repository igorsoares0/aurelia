    "services": {
      "type": "multicolumn",
      "blocks": {
        "c1": {
          "type": "column",
          "settings": {
            "heading": "A note, written by hand",
            "text": "<p>Add what you want said at checkout and it is written on the card packed with the piece. No price appears anywhere in the parcel.</p>"
          }
        },
        "c2": {
          "type": "column",
          "settings": {
            "heading": "Straw-packed, and insured",
            "text": "<p>Double-boxed by hand. If it arrives broken we replace it from the next firing, and we do not ask for the pieces back.</p>",
            "link_label": "Use and care",
            "link": "/pages/care-and-repair"
          }
        },
        "c3": {
          "type": "column",
          "settings": {
            "heading": "A firing, not a warehouse",
            "text": "<p>What is listed is what came out of the last kiln. If it is gone, the next firing is in June or December — write and we will tell you which.</p>"
          }
        }
      },
      "block_order": [
        "c1",
        "c2",
        "c3"
      ],
      "settings": {
        "color_scheme": "ground",
        "heading": "Before you order",
        "columns": 3
      }
    },
    "questions": {
      "type": "collapsible-content",
      "blocks": {
        "q1": {
          "type": "row",
          "settings": {
            "heading": "Can it be returned if it is wrong?",
            "text": "<p>Thirty days, unused, in the original wrapping. A piece that came out of the kiln unlike its photograph is not a fault, and we explain that on the product page before you order.</p>"
          }
        },
        "q2": {
          "type": "row",
          "settings": {
            "heading": "Will they know what it cost?",
            "text": "<p>No. Nothing in the parcel carries a price, and the invoice goes to the person who paid.</p>"
          }
        },
        "q3": {
          "type": "row",
          "settings": {
            "heading": "Can I have it sent straight to them?",
            "text": "<p>Yes. Put their address at checkout and the note in the gift message, and tracking still comes to you.</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3"
      ],
      "settings": {
