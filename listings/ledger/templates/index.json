    "statement": {
      "type": "rich-text",
      "blocks": {
        "eyebrow": {
          "type": "eyebrow",
          "settings": {
            "text": "Firing no. 14"
          }
        },
        "heading": {
          "type": "heading",
          "settings": {
            "text": "<p>Forty pieces a firing.<em>Each one numbered on the foot.</em></p>"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Thrown and glazed in Tiradentes, fired in a wood kiln twice a year. The kiln decides the last ten per cent, which is why no two pieces leave the same.</p>"
          }
        }
      },
      "block_order": [
        "eyebrow",
        "heading",
        "text"
