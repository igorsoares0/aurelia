    "questions": {
      "type": "collapsible-content",
      "blocks": {
        "q1": {
          "type": "row",
          "settings": {
            "heading": "Why do two of the same piece look different?",
            "text": "<p>Because they were in different parts of a wood kiln. The form is repeatable, the glaze is not, and every listing photograph is of a piece from the firing you are buying from.</p>"
          }
        },
        "q2": {
          "type": "row",
          "settings": {
            "heading": "Can these go in the dishwasher?",
            "text": "<p>Everything except iron black in the microwave — the iron in the glaze will heat. Dishwasher is fine for all four glazes.</p>"
          }
        },
        "q3": {
          "type": "row",
          "settings": {
            "heading": "What does the number on the foot mean?",
            "text": "<p>The firing, then the piece within it. No. 14/06 is the sixth piece out of the fourteenth firing. It is recorded against your order.</p>"
          }
        },
        "q4": {
          "type": "row",
          "settings": {
            "heading": "What happens when a firing sells out?",
            "text": "<p>It is not repeated. The next firing is twice a year, in June and December, and the journal says when it is loaded.</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3",
        "q4"
