        "heading": {
          "type": "heading",
          "settings": {
            "text": "One potter, two apprentices, one kiln."
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Teresa has thrown in Tiradentes for nineteen years. The apprentices stay three years each and take the wheel for the second firing of every year — those pieces carry their mark, not hers.</p>"
          }
        },
