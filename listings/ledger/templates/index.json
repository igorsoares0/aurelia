    "provenance": {
      "type": "pinned-story",
      "blocks": {
        "s1": {
          "type": "step",
          "settings": {
            "eyebrow": "The clay",
            "heading": "Dug in Minas, blended here",
            "text": "<p>Two stoneware bodies from the same pit outside São Thomé, blended wet in the yard and rested a month before anything is thrown.</p>"
          }
        },
        "s2": {
          "type": "step",
          "settings": {
            "eyebrow": "Throwing",
            "heading": "Forty pieces, one pair of hands",
            "text": "<p>Every piece is thrown on the wheel and turned by hand at the leather-hard stage. The foot is where the number is cut.</p>"
          }
        },
        "s3": {
          "type": "step",
          "settings": {
            "eyebrow": "Glazing",
            "heading": "Four glazes, mixed by weight",
            "text": "<p>Ash, oatmeal, iron and a clear. All four are mixed here from raw materials, and the recipes are on the journal.</p>"
          }
        },
        "s4": {
          "type": "step",
          "settings": {
            "eyebrow": "The firing",
            "heading": "Thirty-six hours of wood",
            "text": "<p>Stoked in pairs, day and night, to 1,280°C. What the flame does to a glaze on one side of the kiln it will not do on the other.</p>"
          }
        }
      },
      "block_order": [
        "s1",
        "s2",
        "s3",
        "s4"
      ],
      "settings": {
        "color_scheme": "ground",
