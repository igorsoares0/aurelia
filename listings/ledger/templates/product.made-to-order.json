    "provenance": {
      "type": "pinned-story",
      "blocks": {
        "s1": {
          "type": "step",
          "settings": {
            "eyebrow": "Month one",
            "heading": "Thrown, and turned",
            "text": "<p>The whole run is thrown in one sitting so the walls match, then turned at the leather-hard stage and numbered on the foot.</p>"
          }
        },
        "s2": {
          "type": "step",
          "settings": {
            "eyebrow": "Month three",
            "heading": "Glazed by weight",
            "text": "<p>Dipped in the glaze you chose, mixed here from raw materials to the recipe published in the journal.</p>"
          }
        },
        "s3": {
          "type": "step",
          "settings": {
            "eyebrow": "Month six",
            "heading": "Thirty-six hours of wood",
            "text": "<p>Stoked in pairs, day and night, to 1,280°C. We photograph the whole run as it comes out, and you see it before it is packed.</p>"
          }
        }
      },
