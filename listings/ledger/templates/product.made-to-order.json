    "commission": {
      "type": "collapsible-content",
      "blocks": {
        "order": {
          "type": "row",
          "settings": {
            "heading": "What happens after you order",
            "text": "<p>We write within a week to agree the count and the glaze, then the pieces are thrown for the next kiln. We write again when they are glazed and when the kiln is lit.</p>"
          }
        },
        "changes": {
          "type": "row",
          "settings": {
            "heading": "Changing your mind",
            "text": "<p>Any time before the pieces are glazed, in full. After that they are committed to a firing and cannot be un-made.</p>"
          }
        },
        "sizing": {
          "type": "row",
          "settings": {
            "heading": "How close a match can you get?",
            "text": "<p>The form, exactly. The glaze, closely — but a wood kiln decides the last ten per cent, and a commission fired six months apart from your first piece will not be its twin.</p>"
          }
        }
      },
      "block_order": [
        "order",
        "changes",
        "sizing"
      ],
      "settings": {
        "color_scheme": "ground",
        "layout": "disclosures--stacked",
        "heading": "Ordering pieces that do not exist yet",
        "intro": "<p>Nothing here is thrown in advance. A commission waits for a kiln, and these are its terms.</p>",
        "button_label": "The dimensions table",
        "button_link": "/pages/size-guide",
        "open_first": true
