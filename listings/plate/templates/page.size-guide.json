    "questions": {
      "type": "collapsible-content",
      "blocks": {
        "q1": {
          "type": "row",
          "settings": {
            "heading": "What if I am between two sizes?",
            "text": "<p>Take the larger for outerwear and the smaller for shirting. Or write to us with the flat measurements of something that fits, and we will say which.</p>"
          }
        },
        "q2": {
          "type": "row",
          "settings": {
            "heading": "Are these body or garment measurements?",
            "text": "<p>Garment, measured flat, with the piece buttoned and pressed. Body measurements are in the first row of the table as a fitting range.</p>"
          }
        },
        "q3": {
          "type": "row",
          "settings": {
            "heading": "What if it does not fit?",
            "text": "<p>Thirty days, unworn, tags on, and we pay the return. An exchange for another size ships the day the first one lands.</p>"
          }
        },
        "q4": {
          "type": "row",
          "settings": {
            "heading": "Can it be hemmed?",
            "text": "<p>Free on anything we made, for as long as you own it, to the centimetre. Hemmed garments are final sale, and we say so before you order.</p>"
          }
        }
      },
