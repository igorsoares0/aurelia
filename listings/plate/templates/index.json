    "questions": {
      "type": "collapsible-content",
      "blocks": {
        "q1": {
          "type": "row",
          "settings": {
            "heading": "How do the sizes run?",
            "text": "<p>Every garment is listed with flat measurements in centimetres, taken from the graded sample. The size guide has the same table and prints at 1:1 against a tape.</p>"
          }
        },
        "q2": {
          "type": "row",
          "settings": {
            "heading": "What if it does not fit?",
            "text": "<p>Thirty days, unworn, and we pay the return. Exchanges for another size ship the day the first one lands.</p>"
          }
        },
        "q3": {
          "type": "row",
          "settings": {
            "heading": "Do you repair garments?",
            "text": "<p>Free for five years — seams, buttons, linings and moth holes. Post it back and we return it insured.</p>"
          }
        },
        "q4": {
          "type": "row",
          "settings": {
            "heading": "Where is the cloth from?",
            "text": "<p>Named on the label and on every product page: the mill, the town and the weight. Ask for a swatch and we post one before you buy.</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3",
        "q4"
      ],
