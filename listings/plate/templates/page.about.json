      "blocks": {
        "q1": {
          "type": "quote",
          "settings": {
            "quote": "Three winters in the overcoat and it has been pressed twice. The shoulder still sits where it did.",
            "name": "Marina A.",
            "piece": "The Overcoat",
            "year": "2023"
          }
        },
        "q2": {
          "type": "quote",
          "settings": {
            "quote": "I split a seam in the second month. They repaired it in a week and posted it back, free.",
            "name": "Júlia R.",
            "piece": "The Wide Trouser",
            "year": "2025"
          }
        },
        "q3": {
          "type": "quote",
          "settings": {
            "quote": "The linen creases hard and I have stopped apologising for it. That is what the cloth does.",
            "name": "Pedro V.",
            "piece": "The Camp Shirt",
            "year": "2025"
          }
        }
      },
