    "statement": {
      "type": "rich-text",
      "blocks": {
        "eyebrow": {
          "type": "eyebrow",
          "settings": {
            "text": "Since 2017"
          }
        },
        "heading": {
          "type": "heading",
          "settings": {
            "text": "<p>Six people, one room.<em>Eleven garments a season.</em></p>"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>We do not chase a trend and we do not repeat a cloth once the run is finished. What we make is what six people can draft, cut and sew properly in a season, which is about eleven garments.</p>"
          }
        }
      },
      "block_order": [
        "eyebrow",
        "heading",
        "text"
      ],
      "settings": {
        "color_scheme": "ground",
        "alignment": "center"
      }
    },
    "atelier": {
      "type": "image-with-text",
      "blocks": {
        "eyebrow": {
          "type": "eyebrow",
          "settings": {
            "text": "The cutting room"
          }
        },
        "heading": {
          "type": "heading",
          "settings": {
            "text": "São Paulo, one floor, six people."
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Helena opened the room in 2017 with one industrial machine and a borrowed cutting table. Both are still here. Every pattern is drafted and graded on site, and nothing is sewn outside the building.</p>"
          }
        },
        "button": {
          "type": "button",
          "settings": {
            "label": "The repair counter is open six days",
            "link": "/pages/contact"
          }
        }
      },
      "block_order": [
        "eyebrow",
        "heading",
        "text",
        "button"
      ],
      "settings": {
        "color_scheme": "ink",
        "image_position": "left",
        "image_height": 520,
        "image_alt": "Shears and a graded pattern on the cutting table in São Paulo"
      }
    },
    "services": {
      "type": "multicolumn",
      "blocks": {
        "c1": {
          "type": "column",
          "settings": {
            "heading": "Repairs, for five years",
            "text": "<p>Free — seams, buttons, linings and moth holes, for five years from the day it ships. We send a prepaid insured label.</p>",
            "link_label": "Care and repair",
            "link": "/pages/care-and-repair"
          }
        },
        "c2": {
          "type": "column",
          "settings": {
            "heading": "Hemming, whenever",
            "text": "<p>Free on anything we made, for as long as you own it. To the centimetre, in about a week.</p>"
          }
        },
        "c3": {
          "type": "column",
          "settings": {
            "heading": "Alterations, quoted first",
            "text": "<p>Nothing is touched before you have the number. We will say honestly when an alteration is not worth doing.</p>"
          }
        }
      },
      "block_order": [
        "c1",
        "c2",
        "c3"
      ],
      "settings": {
        "color_scheme": "ground",
        "heading": "What comes with a garment",
        "columns": 3
      }
    },
