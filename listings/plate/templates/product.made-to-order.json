    "commission": {
      "type": "collapsible-content",
      "blocks": {
        "order": {
          "type": "row",
          "settings": {
            "heading": "What happens after you order",
            "text": "<p>We write within two days to book a measuring call, then the cloth is cut to your pattern. We write again when it goes on the machine and when it ships.</p>"
          }
        },
        "changes": {
          "type": "row",
          "settings": {
            "heading": "Changing your mind",
            "text": "<p>Within three days, in full, no questions. After that the cloth has been cut to your measurements and cannot be sold to anyone else.</p>"
          }
        },
        "sizing": {
          "type": "row",
          "settings": {
            "heading": "If you cannot come in to be measured",
            "text": "<p>Send the flat measurements of a garment that already fits you well. It is more reliable than measuring yourself, and it is how most of these are ordered.</p>"
          }
        }
      },
