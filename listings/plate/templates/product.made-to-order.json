          "settings": {
            "eyebrow": "Week one",
            "heading": "The cloth is reserved",
            "text": "<p>Cut from the same roll as the sample you were shown, and set aside under your name before anything else is done.</p>"
          }
        },
        "s2": {
          "type": "step",
          "settings": {
            "eyebrow": "Week two",
            "heading": "The pattern is drafted to you",
            "text": "<p>Your measurements are drawn as their own pattern, not graded from a block. It is cut, basted and hung before it is sewn.</p>"
          }
        },
        "s3": {
          "type": "step",
