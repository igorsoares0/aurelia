    "services": {
      "type": "multicolumn",
      "blocks": {
        "c1": {
          "type": "column",
          "settings": {
            "heading": "A note, written by hand",
            "text": "<p>Add what you want said at checkout and it is written on the card that travels with the garment. No price appears anywhere in the parcel.</p>"
          }
        },
        "c2": {
          "type": "column",
          "settings": {
            "heading": "Sized after the fact",
            "text": "<p>Guessing a size is fine. Thirty days to exchange, we pay the return, and hemming is free for as long as they own it.</p>",
            "link_label": "Care and repair",
            "link": "/pages/care-and-repair"
          }
        },
        "c3": {
          "type": "column",
          "settings": {
            "heading": "Five days, not two",
            "text": "<p>Everything is in stock, but it still has to travel. If a date matters, order a week before it, or write and we will say honestly what is possible.</p>"
          }
        }
      },
      "block_order": [
        "c1",
        "c2",
        "c3"
      ],
      "settings": {
        "color_scheme": "ground",
        "heading": "Before you order",
        "columns": 3
      }
    },
    "questions": {
      "type": "collapsible-content",
      "blocks": {
        "q1": {
          "type": "row",
          "settings": {
            "heading": "Can it be returned if it is wrong?",
            "text": "<p>Thirty days, unworn, tags on, and we pay the return. Garments hemmed to a measurement are the exception, and we say so before you order.</p>"
          }
        },
        "q2": {
          "type": "row",
          "settings": {
            "heading": "Will they know what it cost?",
            "text": "<p>No. Nothing in the parcel carries a price, and the invoice goes to the person who paid.</p>"
          }
        },
        "q3": {
          "type": "row",
          "settings": {
            "heading": "Can I have it sent straight to them?",
            "text": "<p>Yes. Put their address at checkout and the note in the gift message, and tracking still comes to you.</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3"
      ],
