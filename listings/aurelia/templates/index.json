    "questions": {
      "type": "collapsible-content",
      "blocks": {
        "q1": {
          "type": "row",
          "settings": {
            "heading": "How long does a piece take?",
            "text": "<p>Twenty-one days from order to shipping. Resizing adds three.</p>"
          }
        },
        "q2": {
          "type": "row",
          "settings": {
            "heading": "Can a piece be resized later?",
            "text": "<p>Free for life, up to three sizes either way. Post it back and we return it insured.</p>"
          }
        },
        "q3": {
          "type": "row",
          "settings": {
            "heading": "Where does the gold come from?",
            "text": "<p>Recycled and refined in São Paulo. We can show the refiner's certificate for any piece.</p>"
          }
        },
        "q4": {
          "type": "row",
          "settings": {
            "heading": "What happens when a chapter closes?",
            "text": "<p>It is not made again. Archive pieces occasionally return, and those are final sale.</p>"
          }
        }
      },
