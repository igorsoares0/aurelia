    "provenance": {
      "type": "pinned-story",
      "blocks": {
        "s1": {
          "type": "step",
          "settings": {
            "eyebrow": "Sourcing",
            "heading": "The gold is refined in São Paulo",
            "text": "<p>Recycled, refined and certified. We can show the refiner's certificate for any piece.</p>"
          }
        },
        "s2": {
          "type": "step",
          "settings": {
            "eyebrow": "Cutting",
            "heading": "Stones are chosen one at a time",
            "text": "<p>Every stone is seen in daylight before it is bought. Nothing is ordered from a photograph.</p>"
          }
        },
        "s3": {
          "type": "step",
          "settings": {
            "eyebrow": "Finishing",
            "heading": "Twenty-one days at the bench",
            "text": "<p>Filed, set and polished by hand. The tool marks inside a band are Túlio's, and they stay.</p>"
          }
        },
        "s4": {
          "type": "step",
          "settings": {
            "eyebrow": "Packing",
            "heading": "Numbered, then wrapped",
            "text": "<p>The piece number is struck last, recorded against your order, and kept for any repair.</p>"
          }
        }
      },
