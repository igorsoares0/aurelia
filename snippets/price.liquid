{% doc %}
  Renders a price, including the sale, sold-out and price-varies cases.

  A discount is worded as well as colored -- "Save 20% — archive price" -- so
  the saving is never carried by color alone, and the old price sits in a real
  `<s>` element rather than a styled span. Screen readers get "Regular price"
  and "Sale price" labels that sighted customers do not need to see.

  Prices are hidden entirely when the merchant sells by request, which is what
  the `product_card_price` setting is for.

  @param {object} product - The product to price
  @param {object} [variant] - The selected variant. Falls back to the product's selected or first available variant.
  @param {string} [class] - Extra classes for the wrapper
  @param {boolean} [show_unit_price] - Render the unit price when the variant has one. Required in the EU and Switzerland.
  @param {boolean} [show_from] - Render "From x" when the price varies across variants

  @example
  {% render 'price', product: product %}
  {% render 'price', product: product, variant: current_variant, show_unit_price: true %}
{% enddoc %}

{% liquid
  assign target = variant | default: product.selected_or_first_available_variant
  assign compare_at = target.compare_at_price | default: product.compare_at_price
  assign price = target.price | default: product.price

  assign on_sale = false
  if compare_at > price
    assign on_sale = true
    assign saving = compare_at | minus: price | times: 100.0 | divided_by: compare_at | round
  endif

  assign varies = false
  if show_from and product.price_varies
    assign varies = true
  endif
%}

<div class="price {{ class }}{% if on_sale %} price--on-sale{% endif %}">
  {%- if varies -%}
    <span class="price__current">
      {{- 'products.from_price_html' | t: price: product.price_min | money -}}
    </span>
  {%- else -%}
    <span class="visually-hidden">
      {%- if on_sale -%}
        {{ 'products.sale_price' | t }}
      {%- else -%}
        {{ 'products.regular_price' | t }}
      {%- endif -%}
    </span>
    <span class="price__current">{{ price | money }}</span>
  {%- endif -%}

  {%- if on_sale -%}
    <span class="visually-hidden">{{ 'products.regular_price' | t }}</span>
    <s class="price__was">{{ compare_at | money }}</s>
    <span class="badge price__saving">{{ 'products.on_sale' | t: percent: saving }}</span>
  {%- endif -%}

  {%- if show_unit_price and target.unit_price_measurement -%}
    <span class="price__unit">
      <span class="visually-hidden">{{ 'products.unit_price' | t }}</span>
      {{ target.unit_price | money }}
      <span aria-hidden="true">/</span>
      {%- if target.unit_price_measurement.reference_value != 1 -%}
        {{ target.unit_price_measurement.reference_value }}
      {%- endif -%}
      {{ target.unit_price_measurement.reference_unit }}
    </span>
  {%- endif -%}
</div>

{% stylesheet %}
  .price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
    font-size: var(--text-detail);
    line-height: 1;
    color: var(--color-heading);
  }

  .price--on-sale .price__current {
    font-weight: var(--font-body--weight-medium);
    color: var(--color-error-rule);
  }

  .price__was {
    color: var(--color-secondary);
    text-decoration-thickness: 1px;
  }

  .price__saving {
    background-color: var(--color-sale-background);
    color: var(--color-error-text);
    border-color: transparent;
  }

  .price__unit {
    flex-basis: 100%;
    font-size: var(--text-caption);
    color: var(--color-secondary);
  }
{% endstylesheet %}
