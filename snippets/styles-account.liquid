{% doc %}
  The styles shared by the seven customer-account sections.

  This snippet renders nothing. It exists because Shopify subsets `{% stylesheet %}`
  CSS to the files in a page's render tree, so styles shared by sections that are
  never rendered together have to be brought in by something each of those
  sections renders. Putting them in `critical.css` instead would ship them to
  every page in the theme, including the ones that have no account on them.

  Render it once, at the top of any section that uses the `.account-page`
  wrapper classes.

  @example
  {% render 'styles-account' %}
{% enddoc %}

{% stylesheet %}
.account-page__narrow {
max-width: 32.5rem;
padding-block: var(--space-13) var(--space-20);
}

.account-page__inner {
display: flex;
flex-direction: column;
gap: var(--space-8);
padding-block: var(--space-8) var(--space-20);
}

.account-page__panel {
display: flex;
flex-direction: column;
gap: var(--space-5);
}

.account-page__title {
font-family: var(--font-heading--family);
font-weight: var(--font-heading--weight);
font-size: var(--text-display-md);
line-height: 1.1;
color: var(--color-heading);
}

.account-page__body {
font-size: var(--text-detail);
line-height: 1.8;
}

.account-page__help {
font-size: var(--text-caption);
line-height: 1.6;
color: var(--color-secondary);
}

.account-form {
display: flex;
flex-direction: column;
align-items: stretch;
gap: var(--space-5);
}

.account-page__links {
display: flex;
flex-wrap: wrap;
justify-content: space-between;
gap: var(--space-4);
}

.account-page__guest {
display: flex;
flex-direction: column;
align-items: flex-start;
gap: var(--space-3);
padding-block-start: var(--space-6);
border-block-start: 1px solid var(--hairline-row);
}

.account-page__check {
display: flex;
align-items: flex-start;
gap: var(--space-3);
min-height: var(--tap-target);
font-size: var(--text-detail);
line-height: 1.6;
cursor: pointer;
}

.account-page__check input {
width: 18px;
height: 18px;
margin-block-start: 0.25em;
flex: 0 0 auto;
accent-color: var(--color-heading);
}

.account-page__actions {
display: flex;
flex-wrap: wrap;
gap: var(--space-3);
}

.account-page__primary {
flex: 1;
}

.account-page__head {
display: flex;
flex-wrap: wrap;
align-items: baseline;
justify-content: space-between;
gap: var(--space-8);
padding-block-end: var(--space-6);
border-block-end: 1px solid var(--hairline-section);
}

.account-page__name {
font-family: var(--font-heading--family);
font-weight: var(--font-heading--weight);
font-size: var(--text-display-lg);
line-height: 1.06;
color: var(--color-heading);
}

.account-page__email {
font-size: var(--text-detail);
color: var(--color-secondary);
}

.account-page__layout {
display: grid;
grid-template-columns: 206px minmax(0, 1fr);
gap: var(--space-13);
align-items: start;
}

.account-page__main {
display: flex;
flex-direction: column;
gap: var(--space-11);
min-width: 0;
}

.account-page__new {
display: flex;
flex-direction: column;
gap: var(--space-4);
padding-block-start: var(--space-8);
border-block-start: 1px solid var(--hairline-section);
}

@media screen and (max-width: 989px) {
.account-page__layout {
  grid-template-columns: minmax(0, 1fr);
  gap: var(--space-6);
}
  }
@media screen and (max-width: 989px) {
  .account-page__layout {
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
  }
  }{% endstylesheet %}
