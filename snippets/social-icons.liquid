{% doc %}
  Renders the social account links the merchant has filled in.

  The theme uses text glyphs rather than an icon set everywhere else, so these
  are drawn as hairline strokes at the same weight as the rules around them
  instead of the solid glyphs most themes ship. Each link carries a visible-to-
  assistive-technology name; the mark itself is `aria-hidden`.

  Nothing renders when no account is set, which is why the placeholder values in
  `settings_schema.json` are empty.

  @param {string} [class] - Extra classes for the list

  @example
  {% render 'social-icons' %}
{% enddoc %}

{% liquid
  assign accounts = ''
  if settings.social_instagram_link != blank
    assign accounts = accounts | append: 'instagram,'
  endif
  if settings.social_facebook_link != blank
    assign accounts = accounts | append: 'facebook,'
  endif
  if settings.social_pinterest_link != blank
    assign accounts = accounts | append: 'pinterest,'
  endif
  if settings.social_youtube_link != blank
    assign accounts = accounts | append: 'youtube,'
  endif
  if settings.social_tiktok_link != blank
    assign accounts = accounts | append: 'tiktok,'
  endif
  if settings.social_x_link != blank
    assign accounts = accounts | append: 'x,'
  endif
  assign accounts = accounts | split: ','
%}

{%- if accounts.size > 0 -%}
  <ul class="social {{ class }}">
    {%- for account in accounts -%}
      {%- liquid
        case account
          when 'instagram'
            assign url = settings.social_instagram_link
            assign name = 'Instagram'
          when 'facebook'
            assign url = settings.social_facebook_link
            assign name = 'Facebook'
          when 'pinterest'
            assign url = settings.social_pinterest_link
            assign name = 'Pinterest'
          when 'youtube'
            assign url = settings.social_youtube_link
            assign name = 'YouTube'
          when 'tiktok'
            assign url = settings.social_tiktok_link
            assign name = 'TikTok'
          when 'x'
            assign url = settings.social_x_link
            assign name = 'X'
        endcase
      -%}
      <li>
        <a class="social__link" href="{{ url }}" rel="noopener" target="_blank">
          <span class="visually-hidden">{{ name }}</span>
          <svg
            class="social__icon"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            {%- case account -%}
              {%- when 'instagram' -%}
                <rect x="2.5" y="2.5" width="15" height="15" rx="4.5"/>
                <circle cx="10" cy="10" r="3.75"/>
                <circle cx="14.6" cy="5.4" r="0.75" fill="currentColor" stroke="none"/>
              {%- when 'facebook' -%}
                <path d="M12.6 3.2h-1.9a3 3 0 0 0-3 3v2.1H6v2.7h1.7v6.8h2.8v-6.8h2l.4-2.7h-2.4V6.6c0-.5.3-.8.8-.8h1.3Z"/>
              {%- when 'pinterest' -%}
                <path d="M7.6 17.2c-.4-1.6-.1-3.4.2-4.7l.9-3.8a3.6 3.6 0 0 1-.3-1.5c0-1.4.8-2.4 1.8-2.4.9 0 1.3.6 1.3 1.4 0 .9-.6 2.2-.9 3.4-.2 1 .5 1.9 1.6 1.9 1.9 0 3.2-2.4 3.2-5.2 0-2.1-1.5-3.7-4.1-3.7a4.7 4.7 0 0 0-4.9 4.7c0 .9.3 1.5.7 2 .2.2.2.3.2.5l-.2.8c0 .3-.2.4-.5.2-1.3-.5-1.9-2-1.9-3.6 0-2.7 2.3-5.9 6.8-5.9 3.6 0 6 2.6 6 5.4 0 3.7-2.1 6.5-5.1 6.5-1 0-2-.6-2.4-1.2l-.6 2.5c-.2.8-.7 1.7-1.1 2.4Z"/>
              {%- when 'youtube' -%}
                <rect x="2" y="5" width="16" height="10" rx="3"/>
                <path d="M8.6 8.1v3.8l3.3-1.9Z"/>
              {%- when 'tiktok' -%}
                <path d="M12.4 2.8v8.9a3.2 3.2 0 1 1-2.6-3.1"/>
                <path d="M12.4 2.8a3.9 3.9 0 0 0 3.8 3.4"/>
              {%- when 'x' -%}
                <path d="m3.2 3.2 13.6 13.6M16.8 3.2 3.2 16.8"/>
            {%- endcase -%}
          </svg>
        </a>
      </li>
    {%- endfor -%}
  </ul>
{%- endif -%}

{% stylesheet %}
  .social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .social__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--tap-target);
    min-height: var(--tap-target);
    color: var(--color-heading);
  }

  .social__link:hover {
    color: var(--color-accent);
  }

  .social__icon {
    width: 20px;
    height: 20px;
  }
{% endstylesheet %}
