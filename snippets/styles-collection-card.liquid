{% doc %}
  Styles shared by the all-collections page and the home page collection list.

  This snippet renders nothing. Shopify subsets `{% stylesheet %}` CSS to the
  files in a page's render tree, so styles shared by sections that never render
  together have to be pulled in by something each of them renders. Keeping them
  in `critical.css` instead would ship them to every page in the theme.

  @example
  {% render 'styles-collection-card' %}
{% enddoc %}

{% stylesheet %}
.collection-card__caption {
display: flex;
align-items: baseline;
justify-content: space-between;
gap: var(--space-4);
margin-block-start: var(--space-4);
padding-block-end: var(--space-3);
border-block-end: 1px solid var(--hairline-group);
}

.collection-card__title {
font-size: var(--text-title-lg);
line-height: 1.2;
}

.collection-card__link {
text-decoration: none;
}

.collection-card__link::after {
content: '';
position: absolute;
inset: 0;
}

.collection-card:hover .collection-card__link {
color: var(--color-accent);
}

.collection-card__count {
font-size: var(--text-label);
font-weight: var(--font-body--weight-medium);
white-space: nowrap;
color: var(--color-secondary);
}
{% endstylesheet %}
