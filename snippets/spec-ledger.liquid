{% doc %}
  Renders the specification ledger: a `<dl>` of terms and values, ruled with
  hairlines rather than boxed.

  Rows come from product metafields under the `custom` namespace. Every read is
  guarded, so a store that has not defined any of them renders the ledger from
  the product's own vendor, type and SKU instead of rendering an empty box. See
  METAFIELDS.md for the definitions.

  On a narrow screen the ledger collapses into a disclosure. It is the same
  `<dl>`; only the `<summary>` appears, and it is hidden again above 990px --
  no duplicate markup and no JavaScript.

  @param {object} product - The product whose specification to show
  @param {object} [variant] - The selected variant, for the SKU fallback
  @param {string} [label_material] - Label for the material row
  @param {string} [label_face] - Label for the dimensions row
  @param {string} [label_origin] - Label for the origin row
  @param {string} [label_care] - Label for the care row
  @param {string} [summary_label] - The disclosure label shown on mobile

  @example
  {% render 'spec-ledger', product: product, variant: variant %}
{% enddoc %}

{% render 'styles-ledger' %}

{% liquid
  assign material = product.metafields.custom.material.value
  assign face = product.metafields.custom.face.value
  assign origin = product.metafields.custom.made_in.value
  assign care = product.metafields.custom.care.value

  assign has_metafields = false
  if material != blank or face != blank or origin != blank or care != blank
    assign has_metafields = true
  endif

  assign summary_text = summary_label | default: 'Specification'
%}

<details class="spec" open>
  <summary class="spec__summary">
    <span>{{ summary_text }}</span>
    <span class="spec__glyph" aria-hidden="true">&minus;</span>
  </summary>

  <dl class="spec__list">
    {%- if has_metafields -%}
      {%- if material != blank -%}
        <dt class="ledger__term">{{ label_material | default: 'Material' }}</dt>
        <dd class="ledger__value">{{ material }}</dd>
      {%- endif -%}
      {%- if face != blank -%}
        <dt class="ledger__term">{{ label_face | default: 'Face' }}</dt>
        <dd class="ledger__value">{{ face }}</dd>
      {%- endif -%}
      {%- if origin != blank -%}
        <dt class="ledger__term">{{ label_origin | default: 'Made in' }}</dt>
        <dd class="ledger__value">{{ origin }}</dd>
      {%- endif -%}
      {%- if care != blank -%}
        <dt class="ledger__term">{{ label_care | default: 'Care' }}</dt>
        <dd class="ledger__value">{{ care }}</dd>
      {%- endif -%}
    {%- else -%}
      {%- comment -%}
        No metafields defined yet. Fall back to what every product already has,
        so the ledger is never an empty rule.
      {%- endcomment -%}
      {%- if product.vendor != blank -%}
        <dt class="ledger__term">{{ 'products.vendor' | t }}</dt>
        <dd class="ledger__value">{{ product.vendor }}</dd>
      {%- endif -%}
      {%- if product.type != blank -%}
        <dt class="ledger__term">{{ label_material | default: 'Material' }}</dt>
        <dd class="ledger__value">{{ product.type }}</dd>
      {%- endif -%}
      {%- if variant.sku != blank -%}
        <dt class="ledger__term">{{ 'products.sku' | t }}</dt>
        <dd class="ledger__value">{{ variant.sku }}</dd>
      {%- endif -%}
      {%- if variant.weight > 0 -%}
        <dt class="ledger__term">{{ 'products.weight' | t }}</dt>
        <dd class="ledger__value">{{ variant.weight | weight_with_unit: variant.weight_unit }}</dd>
      {%- endif -%}
    {%- endif -%}
  </dl>
</details>

{% stylesheet %}
  .spec {
    border-block-start: 1px solid var(--hairline-group);
  }

  .spec__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: 3.25rem;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: var(--text-title-sm);
    color: var(--color-heading);
    cursor: pointer;
    list-style: none;
  }

  .spec__summary::-webkit-details-marker {
    display: none;
  }

  .spec__glyph {
    color: var(--color-accent);
    font-size: 0;
  }

  .spec__glyph::before {
    content: '\2212';
    font-size: var(--text-title-sm);
  }

  .spec:not([open]) .spec__glyph::before {
    content: '+';
  }

  .spec__list {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0;
    margin: 0;
  }

  @media screen and (min-width: 990px) {
    /* The disclosure is a mobile affordance. Above this width the ledger is
       simply a ledger, and the summary would be a control that does nothing. */
    .spec__summary {
      display: none;
    }
  }
{% endstylesheet %}
