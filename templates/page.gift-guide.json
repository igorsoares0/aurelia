    "services": {
      "type": "multicolumn",
      "blocks": {
        "c1": {
          "type": "column",
          "settings": {
            "heading": "A note, written by hand",
            "text": "<p>Add what you want said at checkout and it is written on the card that travels with the piece. No price appears anywhere in the parcel.</p>"
          }
        },
        "c2": {
          "type": "column",
          "settings": {
            "heading": "Sized after the fact",
            "text": "<p>Guessing a ring size is fine. Resizing is free for life, up to three sizes either way, and the first one usually happens in January.</p>",
            "link_label": "Care and repair",
            "link": "/pages/care-and-repair"
          }
        },
        "c3": {
          "type": "column",
          "settings": {
            "heading": "Twenty-one days, not two",
            "text": "<p>Every piece is made after it is ordered. If a date matters, order twenty-one days before it, or write to us and we will tell you honestly what is possible.</p>"
          }
        }
      },
      "block_order": ["c1", "c2", "c3"],
      "settings": { "color_scheme": "ground", "heading": "Before you order", "columns": 3 }
    },
    "questions": {
      "type": "collapsible-content",
      "blocks": {
        "q1": {
          "type": "row",
          "settings": {
            "heading": "Can it be returned if it is wrong?",
            "text": "<p>Thirty days, unworn, in the original wrapping. Engraved pieces are the exception and we say so before you order.</p>"
          }
        },
        "q2": {
          "type": "row",
          "settings": {
            "heading": "Will they know what it cost?",
            "text": "<p>No. Nothing in the parcel carries a price, and the invoice goes to the person who paid.</p>"
          }
        },
        "q3": {
          "type": "row",
          "settings": {
            "heading": "Can I have it sent straight to them?",
            "text": "<p>Yes. Put their address at checkout and the note in the gift message, and tracking still comes to you.</p>"
          }
        }
      },
      "block_order": ["q1", "q2", "q3"],
      "settings": {
        "color_scheme": "ground",
        "layout": "disclosures--sidebar",
        "heading": "Gifting questions",
        "intro": "<p>What people ask before sending a piece to someone else.</p>",
        "open_first": true
      }
    }
