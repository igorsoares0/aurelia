{% comment %}
  Page not found.

  Two ways out -- back to the chapter, and search -- because a 404 that offers
  only a link home makes the customer start over.

  https://shopify.dev/docs/storefronts/themes/architecture/sections
{% endcomment %}

<div class="not-found color-{{ section.settings.color_scheme }} full-width">
  <div class="band">
    <div class="not-found__inner">
      <div class="not-found__text">
        <p class="eyebrow eyebrow--wide">{{ '404.eyebrow' | t }}</p>
        <h1 class="not-found__title">{{ section.settings.heading | escape }}</h1>
        <p class="not-found__body">{{ section.settings.body }}</p>

        <div class="not-found__actions">
          <a class="button button--primary" href="{{ routes.all_products_collection_url }}">
            {{- '404.back_to_shopping' | t -}}
          </a>
          <a class="button button--secondary" href="{{ routes.search_url }}">
            {{- 'search.title' | t -}}
          </a>
        </div>
      </div>

      {%- if section.settings.image != blank -%}
        {% render 'image',
          image: section.settings.image,
          alt: section.settings.image_alt,
          height: 280,
          sizes: '(min-width: 750px) 260px, 90vw',
          loading: 'eager'
        %}
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .not-found {
    background-color: var(--color-background);
    color: var(--color-text);
  }

  .not-found__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    align-items: center;
    gap: var(--space-9);
    padding-block: var(--space-16) var(--space-20);
  }

  .not-found__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    max-width: 38ch;
  }

  .not-found__title {
    font-size: var(--text-display-md);
    line-height: 1.1;
  }

  .not-found__body {
    font-size: var(--text-body);
    line-height: 1.8;
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-block-start: var(--space-2);
  }

  @media screen and (max-width: 749px) {
    .not-found__inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.404",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "ground"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "This piece has been kept."
    },
    {
      "type": "text",
      "id": "body",
      "label": "t:labels.text",
      "default": "The page you asked for is not here. It may have moved, or the chapter may have closed."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "t:labels.image_alt",
      "info": "t:info.image_alt"
    }
  ],
  "enabled_on": {
    "templates": ["404"]
  }
}
{% endschema %}
