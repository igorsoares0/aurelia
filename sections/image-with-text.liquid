{% comment %}
  The atelier band: a photograph beside a paragraph, on the ink ground.

  This is the section that introduces the theme's second ground. The page has
  two grounds and no more, so this band and the testimonials that follow it
  share one -- there is no colour change between them.

  https://shopify.dev/docs/storefronts/themes/architecture/sections
{% endcomment %}

<div class="atelier color-{{ section.settings.color_scheme }} full-width">
  <div class="band">
    <div
      class="atelier__inner atelier__inner--{{ section.settings.image_position }} section-padding--loose"
      {% if settings.motion_reveal %}data-reveal{% endif %}
    >
      <div class="atelier__media">
        {% render 'image',
          image: section.settings.image,
          alt: section.settings.image_alt,
          height: section.settings.image_height,
          sizes: '(min-width: 990px) 50vw, 100vw',
          placeholder: 'lifestyle-2'
        %}
      </div>

      <div class="atelier__text">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'eyebrow' -%}
              <p class="eyebrow eyebrow--wide" {{ block.shopify_attributes }}>
                {{- block.settings.text | escape -}}
              </p>

            {%- when 'heading' -%}
              <h2 class="atelier__heading" {{ block.shopify_attributes }}>
                {{- block.settings.text | escape -}}
              </h2>

            {%- when 'text' -%}
              <div class="atelier__body rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

            {%- when 'button' -%}
              {%- if block.settings.label != blank -%}
                <a
                  class="button button--secondary"
                  href="{{ block.settings.link }}"
                  {{ block.shopify_attributes }}
                >
                  {{- block.settings.label | escape -}}
                </a>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .atelier {
    background-color: var(--color-background);
    color: var(--color-text);
  }

  .atelier__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--space-18);
  }

  .atelier__inner--right .atelier__media {
    order: 2;
  }

  .atelier__media {
    min-width: 0;
  }

  .atelier__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
    min-width: 0;
  }

  .atelier__heading {
    font-size: var(--text-display-md);
    line-height: 1.2;
  }

  .atelier__body {
    max-width: 28.75rem;
    font-size: var(--text-body-md);
    line-height: 1.8;
  }

  @media screen and (max-width: 989px) {
    /* Restructured: image over text, not two narrow columns. */
    .atelier__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-8);
    }

    .atelier__inner--right .atelier__media {
      order: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.image_with_text",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "ink"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "t:labels.image_alt",
      "info": "t:info.image_alt",
      "default": "Hands and tools at the bench"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:labels.image_position",
      "options": [
        { "value": "left", "label": "t:options.image_position.left" },
        { "value": "right", "label": "t:options.image_position.right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "t:labels.image_height",
      "min": 300,
      "max": 700,
      "step": 20,
      "unit": "px",
      "default": 520
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "t:labels.eyebrow",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "t:labels.text", "default": "The atelier" }
      ]
    },
    {
      "type": "heading",
      "name": "t:general.heading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:labels.heading",
          "default": "Everything is made here, by four people."
        }
      ]
    },
    {
      "type": "text",
      "name": "t:general.text",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "t:labels.text",
          "default": "<p>The gold is recycled and refined in São Paulo. The stones are bought from two cutters we have used for eleven years. Nothing is cast off site.</p>"
        }
      ]
    },
    {
      "type": "button",
      "name": "t:general.button",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:labels.button_label",
          "default": "How a piece is made"
        },
        { "type": "url", "id": "link", "label": "t:labels.button_link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.preset_image_and_text",
      "category": "t:general.cat_content",
      "blocks": [
        { "type": "eyebrow" },
        { "type": "heading" },
        { "type": "text" },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}
