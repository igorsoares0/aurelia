{% comment %}
  The masthead: navigation left, wordmark centred, search and bag right.

  The three columns are `minmax(0, 1fr) auto minmax(0, 1fr)` rather than
  `1fr auto 1fr` so the outer columns can shrink below their content at 320px
  and at 200% zoom instead of forcing the page to scroll sideways.

  The wordmark's `text-indent` matches its letter-spacing. Tracked type carries
  a trailing space after the last letter, and the indent puts it back so the
  block sits optically centred rather than a third of an em to the left.

  https://shopify.dev/docs/storefronts/themes/architecture/sections
{% endcomment %}

{% liquid
  assign menu = section.settings.menu
  assign bag_count = cart.item_count
%}

<header
  class="header color-{{ section.settings.color_scheme }}{% if section.settings.sticky %} header--sticky{% endif %} full-width"
  data-cart-section="{{ section.id }}"
>
  <div class="header__inner">
    <div class="header__lead">
      <button
        class="header__icon header__menu-toggle"
        type="button"
        data-overlay-open="MobileMenu"
        aria-expanded="false"
        aria-controls="MobileMenu"
      >
        <span class="visually-hidden">{{ 'accessibility.open_menu' | t }}</span>
        <span class="header__bars" aria-hidden="true"></span>
      </button>

      <nav class="header__nav" aria-label="{{ 'general.menu' | t }}">
        <ul class="header__nav-list">
          {%- for link in menu.links -%}
            <li class="header__nav-item">
              {%- if link.links.size > 0 -%}
                <details class="header__disclosure">
                  <summary class="header__nav-link">
                    {{- link.title -}}
                    <span class="header__caret" aria-hidden="true">+</span>
                  </summary>
                  <ul class="header__submenu">
                    {%- for child in link.links -%}
                      <li>
                        {%- if child.links.size > 0 -%}
                          <details class="header__disclosure">
                            <summary class="header__submenu-link">
                              {{- child.title -}}
                              <span class="header__caret" aria-hidden="true">+</span>
                            </summary>
                            <ul class="header__submenu header__submenu--nested">
                              {%- for grandchild in child.links -%}
                                <li>
                                  <a
                                    class="header__submenu-link"
                                    href="{{ grandchild.url }}"
                                    {% if grandchild.current %}aria-current="page"{% endif %}
                                  >
                                    {{- grandchild.title -}}
                                  </a>
                                </li>
                              {%- endfor -%}
                            </ul>
                          </details>
                        {%- else -%}
                          <a
                            class="header__submenu-link"
                            href="{{ child.url }}"
                            {% if child.current %}aria-current="page"{% endif %}
                          >
                            {{- child.title -}}
                          </a>
                        {%- endif -%}
                      </li>
                    {%- endfor -%}
                  </ul>
                </details>
              {%- else -%}
                <a
                  class="header__nav-link"
                  href="{{ link.url }}"
                  {% if link.current %}aria-current="page"{% endif %}
                >
                  {{- link.title -}}
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    </div>

    {%- liquid
      assign wordmark_tag = 'div'
      if request.page_type == 'index'
        assign wordmark_tag = 'h1'
      endif
    -%}
    <{{ wordmark_tag }} class="header__wordmark-wrap">
      <a class="header__wordmark" href="{{ routes.root_url }}">
        {%- if settings.logo != blank -%}
          <span class="visually-hidden">{{ 'accessibility.home' | t: shop_name: shop.name }}</span>
          {{
            settings.logo
            | image_url: width: 600
            | image_tag:
              widths: '150, 300, 450, 600',
              sizes: '(min-width: 750px) 200px, 140px',
              alt: shop.name,
              class: 'header__logo',
              loading: 'eager'
          }}
        {%- else -%}
          {{ shop.name }}
        {%- endif -%}
      </a>
    </{{ wordmark_tag }}>

    <div class="header__trail">
      {%- if section.settings.show_search -%}
        <button
          class="header__icon header__action"
          type="button"
          data-overlay-open="SearchOverlay"
          aria-expanded="false"
          aria-controls="SearchOverlay"
        >
          {{ 'search.title' | t }}
        </button>
      {%- endif -%}

      {%- if section.settings.show_account -%}
        {% comment %}
          The account component is required in both the desktop and the mobile
          header. It renders Shopify's own control, so it is not styled here
          beyond the space it sits in.
        {% endcomment %}
        <shopify-account class="header__account"></shopify-account>
      {%- endif -%}

      <a class="header__icon header__action header__bag" href="{{ routes.cart_url }}" data-bag-link>
        <span aria-hidden="true">{{ 'cart.title' | t }} ({{ bag_count }})</span>
        <span class="visually-hidden">
          {%- if bag_count == 0 -%}
            {{ 'accessibility.bag_empty' | t }}
          {%- elsif bag_count == 1 -%}
            {{ 'accessibility.bag_count_one' | t }}
          {%- else -%}
            {{ 'accessibility.bag_count' | t: count: bag_count }}
          {%- endif -%}
        </span>
      </a>
    </div>
  </div>
</header>

<aurelia-overlay id="MobileMenu" class="overlay overlay--top header__mobile-menu color-ink">
  <button class="overlay__scrim" type="button" data-overlay-close>
    <span class="visually-hidden">{{ 'general.close' | t }}</span>
  </button>

  <div class="overlay__sheet" role="dialog" aria-modal="true" aria-labelledby="MobileMenuTitle">
    <div class="header__mobile-head">
      <h2 class="visually-hidden" id="MobileMenuTitle">{{ 'general.menu' | t }}</h2>
      <span class="header__wordmark header__wordmark--compact">{{ shop.name }}</span>
      <button class="header__icon" type="button" data-overlay-close>
        <span class="visually-hidden">{{ 'accessibility.close_menu' | t }}</span>
        <span aria-hidden="true">&times;</span>
      </button>
    </div>

    <nav class="header__mobile-nav" aria-label="{{ 'general.menu' | t }}">
      <ul class="header__mobile-list">
        {%- for link in menu.links -%}
          <li>
            {%- if link.links.size > 0 -%}
              <details class="header__disclosure">
                <summary class="header__mobile-link">
                  {{- link.title -}}
                  <span class="header__caret" aria-hidden="true">+</span>
                </summary>
                <ul class="header__mobile-sublist">
                  {%- for child in link.links -%}
                    <li>
                      <a class="header__mobile-sublink" href="{{ child.url }}">{{ child.title }}</a>
                    </li>
                  {%- endfor -%}
                </ul>
              </details>
            {%- else -%}
              <a
                class="header__mobile-link"
                href="{{ link.url }}"
                {% if link.current %}aria-current="page"{% endif %}
              >
                {{- link.title -}}
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="header__mobile-foot">
      {%- if section.settings.show_account -%}
        <shopify-account class="header__account"></shopify-account>
      {%- endif -%}
      {% render 'localization-form', id: 'MenuLocalization', class: 'localization--stacked' %}
    </div>
  </div>
</aurelia-overlay>

{% stylesheet %}
  .header {
    background-color: var(--color-background);
    color: var(--color-text);
    border-block-end: 1px solid var(--hairline-section);
  }

  .header--sticky {
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .header__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-6) var(--page-margin) var(--space-5);
  }

  .header__lead {
    display: flex;
    align-items: center;
    min-width: 0;
  }

  .header__nav-list,
  .header__submenu,
  .header__mobile-list,
  .header__mobile-sublist {
    display: flex;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .header__nav-list {
    gap: var(--space-6);
    flex-wrap: wrap;
  }

  .header__nav-link,
  .header__action {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: var(--tap-target);
    font-size: var(--text-label);
    font-weight: var(--font-body--weight-medium);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    color: var(--color-heading);
    cursor: pointer;
  }

  .header__nav-link[aria-current='page'] {
    border-block-end: 1px solid var(--color-heading);
  }

  .header__nav-link:hover,
  .header__action:hover {
    color: var(--color-accent);
  }

  .header__disclosure {
    position: relative;
  }

  .header__disclosure > summary {
    list-style: none;
  }

  .header__disclosure > summary::-webkit-details-marker {
    display: none;
  }

  .header__caret {
    color: var(--color-accent);
  }

  .header__disclosure[open] > summary .header__caret {
    /* A minus, drawn rather than swapped, so the glyph never reflows. */
    font-size: 0;
  }

  .header__disclosure[open] > summary .header__caret::before {
    content: '\2212';
    font-size: var(--text-label);
  }

  .header__submenu {
    position: absolute;
    z-index: 30;
    top: 100%;
    left: 0;
    flex-direction: column;
    min-width: 14rem;
    padding: var(--space-3) 0;
    background-color: var(--color-background);
    border: 1px solid var(--hairline-group);
  }

  .header__submenu--nested {
    position: static;
    border: 0;
    padding: 0 0 0 var(--space-4);
  }

  .header__submenu-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: var(--tap-target);
    padding-inline: var(--space-4);
    font-size: var(--text-detail);
    text-decoration: none;
    color: var(--color-heading);
    cursor: pointer;
  }

  .header__submenu-link:hover {
    background-color: var(--color-tint);
    color: var(--color-accent);
  }

  .header__wordmark-wrap {
    margin: 0;
    text-align: center;
  }

  .header__wordmark {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: var(--text-title-lg);
    line-height: 1;
    letter-spacing: var(--tracking-wordmark);
    /* Puts back the trailing space that letter-spacing adds after the last
       letter, so the wordmark reads as optically centred. */
    text-indent: var(--tracking-wordmark);
    text-decoration: none;
    text-transform: uppercase;
    color: var(--color-heading);
  }

  .header__wordmark--compact {
    font-size: var(--text-body-md);
    letter-spacing: 0.3em;
    text-indent: 0.3em;
  }

  .header__logo {
    width: auto;
    max-height: 3rem;
  }

  .header__trail {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-5);
    min-width: 0;
  }

  .header__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--tap-target);
    min-height: var(--tap-target);
    color: var(--color-heading);
  }

  .header__menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
  }

  .header__bars,
  .header__bars::before {
    display: block;
    width: 22px;
    height: 1px;
    background-color: currentcolor;
  }

  .header__bars::before {
    content: '';
    transform: translateY(-6px);
  }

  /* Mobile menu */
  .header__mobile-menu .overlay__sheet {
    min-height: 100svh;
  }

  .header__mobile-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-5);
    border-block-end: 1px solid var(--hairline-group);
  }

  .header__mobile-nav {
    flex: 1;
    overflow-y: auto;
    padding: var(--space-6) var(--space-5) 0;
  }

  .header__mobile-list,
  .header__mobile-sublist {
    flex-direction: column;
  }

  .header__mobile-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: var(--text-display-xs);
    line-height: 1.1;
    text-decoration: none;
    color: var(--color-heading);
    border-block-end: 1px solid var(--hairline-group);
    cursor: pointer;
  }

  .header__mobile-sublink {
    display: flex;
    align-items: center;
    min-height: var(--tap-target);
    padding-inline-start: var(--space-4);
    font-size: var(--text-detail);
    text-decoration: none;
    color: var(--color-text);
  }

  .header__mobile-foot {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: var(--space-8) var(--space-5);
  }

  .localization--stacked .localization__form {
    flex-direction: column;
    align-items: stretch;
  }

  @media screen and (max-width: 989px) {
    .header__inner {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      gap: var(--space-3);
      padding: var(--space-3) var(--page-margin);
    }

    .header__menu-toggle {
      display: inline-flex;
    }

    .header__nav {
      display: none;
    }

    .header__account {
      display: none;
    }

    .header__trail {
      gap: var(--space-3);
    }
  }

  @media screen and (min-width: 990px) {
    .header__mobile-menu {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "tag": "section",
  "class": "shopify-section--header",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "ground"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.main_menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "t:labels.sticky_header",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "t:labels.show_search",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "t:labels.show_account",
      "default": true
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
