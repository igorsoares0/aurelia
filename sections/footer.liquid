{% comment %}
  The footer: email signup on the left, link columns on the right, then the
  utility row with localization, payment icons and the copyright.

  Every footer link clears the 44px touch-target floor through its own vertical
  padding rather than through a fixed height, so a link that wraps to two lines
  still meets it.

  https://shopify.dev/docs/storefronts/themes/architecture/sections
{% endcomment %}

<footer class="footer color-{{ section.settings.color_scheme }} full-width">
  <div class="footer__inner">
    <div class="footer__lead">
      <a class="footer__wordmark" href="{{ routes.root_url }}">{{ shop.name }}</a>

      {%- if section.settings.show_newsletter -%}
        <div class="footer__newsletter">
          {%- if section.settings.newsletter_heading != blank -%}
            <p class="footer__newsletter-heading">{{ section.settings.newsletter_heading | escape }}</p>
          {%- endif -%}
          {% render 'newsletter-form',
            id: 'FooterNewsletter',
            label: section.settings.newsletter_label,
            note: section.settings.newsletter_note
          %}
        </div>
      {%- endif -%}

      {% render 'social-icons', class: 'footer__social' %}

      {%- if section.settings.show_follow_on_shop -%}
        {% comment %}
          Follow on Shop. The button is Shopify's own and its colors are not
          ours to change.
        {% endcomment %}
        <div class="footer__follow">{{ shop | login_button: action: 'follow' }}</div>
      {%- endif -%}
    </div>

    <div class="footer__columns">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            <nav class="footer__column" aria-label="{{ block.settings.heading | escape }}" {{ block.shopify_attributes }}>
              <h2 class="footer__column-heading">{{ block.settings.heading | escape }}</h2>
              <ul class="footer__links">
                {%- for link in block.settings.menu.links -%}
                  <li>
                    <a class="footer__link" href="{{ link.url }}">{{ link.title }}</a>
                  </li>
                {%- endfor -%}
              </ul>
            </nav>

          {%- when 'text' -%}
            <div class="footer__column" {{ block.shopify_attributes }}>
              <h2 class="footer__column-heading">{{ block.settings.heading | escape }}</h2>
              <div class="footer__text rte">{{ block.settings.text }}</div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="footer__utility">
    {% render 'localization-form', id: 'FooterLocalization' %}

    <div class="footer__utility-end">
      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul class="footer__payment" aria-label="{{ 'general.payment_methods' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <p class="footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ powered_by_link }}
      </p>
    </div>
  </div>
</footer>

{% stylesheet %}
  .footer {
    background-color: var(--color-background);
    color: var(--color-text);
    border-block-start: 1px solid var(--hairline-section);
  }

  .footer__inner {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: var(--space-16);
    padding: var(--space-16) var(--page-margin) var(--space-8);
  }

  .footer__lead {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .footer__wordmark {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: var(--text-body-md);
    line-height: 1;
    letter-spacing: 0.3em;
    text-indent: 0.3em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-heading);
  }

  .footer__newsletter {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer__newsletter-heading {
    font-size: var(--text-detail);
    line-height: 1.6;
    max-width: 25rem;
  }

  .footer__columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
    gap: var(--space-11);
  }

  .footer__column {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }

  .footer__column-heading {
    font-family: var(--font-body--family);
    font-size: var(--text-label);
    font-weight: var(--font-body--weight-medium);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-secondary);
  }

  .footer__links {
    display: flex;
    flex-direction: column;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .footer__link {
    display: flex;
    align-items: center;
    min-height: var(--tap-target);
    padding-block: var(--space-2);
    font-size: var(--text-detail);
    text-decoration: none;
    color: var(--color-text);
  }

  .footer__link:hover {
    color: var(--color-accent);
  }

  .footer__text {
    font-size: var(--text-detail);
  }

  .footer__utility {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
    padding: var(--space-6) var(--page-margin) var(--space-8);
    border-block-start: 1px solid var(--hairline-row);
  }

  .footer__utility-end {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
  }

  .footer__follow {
    display: flex;
  }

  .footer__payment {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .footer__payment-icon {
    width: 38px;
    height: 24px;
  }

  .footer__copyright {
    font-size: var(--text-caption);
    color: var(--color-secondary);
  }

  @media screen and (max-width: 989px) {
    .footer__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-11);
      padding-block-start: var(--space-11);
    }

    .footer__columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-8);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "ground"
    },
    {
      "type": "header",
      "content": "t:general.newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "t:labels.show_newsletter",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "t:labels.heading",
      "default": "The journal, about six times a year. Chapters, materials, and what the bench is making."
    },
    {
      "type": "text",
      "id": "newsletter_label",
      "label": "t:labels.label",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "newsletter_note",
      "label": "t:labels.note",
      "default": "Leave whenever you like."
    },
    {
      "type": "checkbox",
      "id": "show_follow_on_shop",
      "label": "t:labels.show_follow_on_shop",
      "info": "t:info.show_follow_on_shop",
      "default": true
    },
    {
      "type": "header",
      "content": "t:general.payment"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "t:general.menu_item",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:labels.menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:general.text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "The house"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:labels.text",
          "default": "<p>Belo Horizonte. Twelve pieces a year, in 18k recycled gold.</p>"
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  },
  "presets": [
    {
      "name": "t:general.footer",
      "blocks": [
        { "type": "menu" },
        { "type": "menu" }
      ]
    }
  ]
}
{% endschema %}
