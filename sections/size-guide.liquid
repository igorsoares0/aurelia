{% comment %}
  A ring sizer that is correct on paper, which is the only place a ring sizer is
  of any use.

  Three things make that true, and all three are easy to leave out:

  1. Every measurement is in `mm`, a physical CSS unit. On paper a CSS
     millimetre is a millimetre. On screen it is 96/25.4 device pixels, which is
     a guess about the display -- so the page says, in words, that the screen
     version is not to scale.
  2. The circles are SVG, not CSS. The theme bans `border-radius` outside the
     swatch dot, and a stroked SVG circle is geometry rather than decoration:
     it also lets the stroke sit exactly on the diameter instead of outside it.
  3. A 100mm rule is printed alongside. If it does not measure 100mm the print
     was scaled, and every circle on the sheet is wrong by the same factor. That
     check is the whole difference between this and a picture of some circles.

  Sizes are entered as inner circumference in whole millimetres -- which is what
  Brazilian and European sizing already are -- and the diameter is computed.
  Entering a diameter would mean decimals in a `range`, which the schema cannot
  express at this precision.

  https://shopify.dev/docs/storefronts/themes/architecture/sections
{% endcomment %}

{% liquid
  assign pi = 3.14159
  assign rule_mm = section.settings.rule_length
%}

<div class="sizer color-{{ section.settings.color_scheme }} full-width">
  <div class="band">
    <div
      class="sizer__inner section-padding"
      {% if settings.motion_reveal %}data-reveal{% endif %}
    >
      <div class="sizer__head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow eyebrow--wide">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="sizer__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}
          <div class="sizer__intro rte">{{ section.settings.intro }}</div>
        {%- endif -%}
      </div>

      {%- if section.settings.warning != blank -%}
        <div class="sizer__warning callout" role="note">{{ section.settings.warning }}</div>
      {%- endif -%}

      <div class="sizer__check">
        <h3 class="sizer__subheading">{{ 'products.sizer_check_heading' | t }}</h3>
        <p class="sizer__note">{{ 'products.sizer_check_body' | t: length: rule_mm }}</p>

        <svg
          class="sizer__rule"
          width="{{ rule_mm }}mm"
          height="12mm"
          viewBox="0 0 {{ rule_mm }} 12"
          role="img"
          aria-label="{{ 'products.sizer_rule_alt' | t: length: rule_mm }}"
        >
          <line x1="0" y1="1" x2="{{ rule_mm }}" y2="1" stroke="currentColor" stroke-width="0.3" />
          {%- assign ticks = rule_mm | divided_by: 10 -%}
          {%- for i in (0..ticks) -%}
            {%- assign x = i | times: 10 -%}
            <line
              x1="{{ x }}"
              y1="1"
              x2="{{ x }}"
              y2="5"
              stroke="currentColor"
              stroke-width="0.3"
            />
            <text x="{{ x }}" y="10" font-size="3.2" fill="currentColor" text-anchor="middle">
              {{- x -}}
            </text>
          {%- endfor -%}
        </svg>
      </div>

      <ul class="sizer__grid" style="--columns: {{ section.settings.columns }};">
        {%- for block in section.blocks -%}
          {%- liquid
            assign circumference = block.settings.circumference
            assign diameter = circumference | divided_by: pi | round: 2
            assign box = diameter | plus: 1
            assign centre = box | divided_by: 2.0
            assign radius = diameter | divided_by: 2.0
          -%}
          <li class="sizer__item" {{ block.shopify_attributes }}>
            <svg
              class="sizer__circle"
              width="{{ box }}mm"
              height="{{ box }}mm"
              viewBox="0 0 {{ box }} {{ box }}"
              aria-hidden="true"
              focusable="false"
            >
              <circle
                cx="{{ centre }}"
                cy="{{ centre }}"
                r="{{ radius }}"
                fill="none"
                stroke="currentColor"
                stroke-width="0.3"
              />
            </svg>
            <p class="sizer__size">{{ block.settings.label | escape }}</p>
            <p class="sizer__measure">
              {{ 'products.sizer_measurements' | t: diameter: diameter, circumference: circumference }}
            </p>
          </li>
        {%- endfor -%}
      </ul>

      <div class="sizer__methods">
        <div class="sizer__method">
          <h3 class="sizer__subheading">{{ 'products.sizer_method_ring' | t }}</h3>
          <ol class="sizer__steps">
            <li>{{ 'products.sizer_ring_1' | t }}</li>
            <li>{{ 'products.sizer_ring_2' | t }}</li>
            <li>{{ 'products.sizer_ring_3' | t }}</li>
          </ol>
        </div>

        <div class="sizer__method">
          <h3 class="sizer__subheading">{{ 'products.sizer_method_finger' | t }}</h3>
          <ol class="sizer__steps">
            <li>{{ 'products.sizer_finger_1' | t }}</li>
            <li>{{ 'products.sizer_finger_2' | t: length: rule_mm }}</li>
            <li>{{ 'products.sizer_finger_3' | t }}</li>
          </ol>
        </div>
      </div>

      {%- if section.settings.footnote != blank -%}
        <div class="sizer__footnote rte">{{ section.settings.footnote }}</div>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .sizer {
    background-color: var(--color-background);
    color: var(--color-text);
  }

  .sizer__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-9);
  }

  .sizer__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 52ch;
  }

  .sizer__heading {
    font-size: var(--text-display-sm);
    line-height: 1.1;
  }

  .sizer__intro {
    font-size: var(--text-lead);
    line-height: 1.6;
  }

  .sizer__subheading {
    font-size: var(--text-title-sm);
    line-height: 1.25;
    margin-block-end: var(--space-2);
  }

  .sizer__note,
  .sizer__measure {
    font-size: var(--text-caption);
    line-height: 1.6;
    color: var(--color-secondary);
  }

  .sizer__check {
    padding-block-start: var(--space-5);
    border-block-start: 1px solid var(--hairline-group);
  }

  .sizer__rule {
    display: block;
    margin-block-start: var(--space-4);
    max-width: 100%;
    color: var(--color-heading);
  }

  .sizer__grid {
    display: grid;
    grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
    gap: var(--space-8);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .sizer__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    padding-block-start: var(--space-5);
    border-block-start: 1px solid var(--hairline-group);
    text-align: center;
    break-inside: avoid;
  }

  .sizer__circle {
    display: block;
    color: var(--color-heading);
  }

  .sizer__size {
    font-family: var(--font-heading--family);
    font-size: var(--text-title-sm);
    color: var(--color-heading);
  }

  .sizer__methods {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-11);
  }

  .sizer__steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-inline-start: var(--space-5);
    margin: 0;
    font-size: var(--text-detail);
    line-height: 1.75;
  }

  .sizer__footnote {
    font-size: var(--text-caption);
    line-height: 1.6;
    color: var(--color-secondary);
  }

  /* Mobile restructure: the two methods stop being columns and become one
     sequence, and the circle grid drops to whatever fits without shrinking a
     single circle -- a scaled circle is a wrong circle, so the grid reflows
     instead of resizing. */
  @media screen and (max-width: 749px) {
    .sizer__methods {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-8);
    }

    .sizer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6);
    }
  }

  @media print {
    /* The sheet is the deliverable. Ink is black on white so the stroke is
       measurable, and nothing is allowed to reflow the circles. */
    .sizer {
      background-color: #fff;
      color: #000;
    }

    .sizer__circle,
    .sizer__rule,
    .sizer__size {
      color: #000;
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }

    .sizer__warning {
      border: 1px solid #000;
    }

    .sizer__methods {
      break-inside: avoid;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.size_guide",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "ground"
    },
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "Sizing" },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Print this, and measure a ring you already wear"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "t:labels.intro",
      "default": "<p>Every band is resized free for life, up to three sizes either way. This sheet is here so the first one usually is not needed.</p>"
    },
    {
      "type": "richtext",
      "id": "warning",
      "label": "t:labels.print_warning",
      "info": "t:info.print_warning",
      "default": "<p>Print at 100%. In the print dialog set scale to 100% or Actual size — Fit to page will shrink the sheet and every circle with it. On screen this page is not to scale.</p>"
    },
    {
      "type": "range",
      "id": "rule_length",
      "label": "t:labels.rule_length",
      "info": "t:info.rule_length",
      "min": 60,
      "max": 150,
      "step": 10,
      "unit": "mm",
      "default": 100
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:labels.columns",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 5
    },
    {
      "type": "richtext",
      "id": "footnote",
      "label": "t:labels.footnote",
      "default": "<p>Sizes are inner circumference in millimetres, which is what Brazilian and European sizing measure. If you are between two, take the larger and tell us — we set it to the finger, not to the table.</p>"
    }
  ],
  "blocks": [
    {
      "type": "size",
      "name": "t:general.size",
      "settings": [
        { "type": "text", "id": "label", "label": "t:labels.size_label", "default": "14" },
        {
          "type": "range",
          "id": "circumference",
          "label": "t:labels.circumference",
          "info": "t:info.circumference",
          "min": 40,
          "max": 76,
          "step": 1,
          "unit": "mm",
          "default": 54
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.preset_size_guide",
      "category": "t:general.cat_content",
      "blocks": [
        { "type": "size", "settings": { "label": "10", "circumference": 50 } },
        { "type": "size", "settings": { "label": "12", "circumference": 52 } },
        { "type": "size", "settings": { "label": "14", "circumference": 54 } },
        { "type": "size", "settings": { "label": "16", "circumference": 56 } },
        { "type": "size", "settings": { "label": "18", "circumference": 58 } },
        { "type": "size", "settings": { "label": "20", "circumference": 60 } },
        { "type": "size", "settings": { "label": "22", "circumference": 62 } },
        { "type": "size", "settings": { "label": "24", "circumference": 64 } },
        { "type": "size", "settings": { "label": "26", "circumference": 66 } },
        { "type": "size", "settings": { "label": "28", "circumference": 68 } }
      ]
    }
  ]
}
{% endschema %}
