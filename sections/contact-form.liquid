{% comment %}
  The contact form.

  Required on `page.contact` for the Theme Store. Errors are summarised in
  `role="alert"` and each failing field is marked `aria-invalid` and tied to its
  own message -- a summary alone tells someone something is wrong but not where.

  https://shopify.dev/docs/storefronts/themes/architecture/sections
{% endcomment %}

<div class="contact color-{{ section.settings.color_scheme }} full-width">
  <div class="band">
    <div class="contact__inner">
      {%- if section.settings.heading != blank -%}
        <h2 class="contact__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <div class="contact__intro rte">{{ section.settings.intro }}</div>
      {%- endif -%}

      {% form 'contact', class: 'contact__form', novalidate: 'novalidate' %}
        {%- if form.posted_successfully? -%}
          <div class="callout" role="status">{{ 'contact.success' | t }}</div>
        {%- elsif form.errors -%}
          <div class="form-error-summary" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="field">
          <label class="field__label" for="ContactName">{{ 'contact.name' | t }}</label>
          <input
            class="field__input"
            id="ContactName"
            type="text"
            name="contact[name]"
            value="{{ form.name }}"
            autocomplete="name"
          >
        </div>

        <div class="field">
          <label class="field__label" for="ContactEmail">{{ 'contact.email' | t }}</label>
          <input
            class="field__input"
            id="ContactEmail"
            type="email"
            name="contact[email]"
            value="{{ form.email }}"
            autocomplete="email"
            autocapitalize="off"
            spellcheck="false"
            required
            {% if form.errors.messages.email %}
              aria-invalid="true"
              aria-describedby="ContactEmailError"
            {% endif %}
          >
          {%- if form.errors.messages.email -%}
            <p class="field__error" id="ContactEmailError">
              <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
              {{ form.errors.messages.email }}
            </p>
          {%- endif -%}
        </div>

        <div class="field contact__wide">
          <label class="field__label" for="ContactPhone">{{ 'contact.phone' | t }}</label>
          <input
            class="field__input"
            id="ContactPhone"
            type="tel"
            name="contact[phone]"
            value="{{ form.phone }}"
            autocomplete="tel"
          >
        </div>

        <div class="field contact__wide">
          <label class="field__label" for="ContactMessage">{{ 'contact.message' | t }}</label>
          <textarea
            class="field__textarea"
            id="ContactMessage"
            name="contact[body]"
            rows="6"
            required
          >{{ form.body }}</textarea>
        </div>

        <div class="contact__wide">
          <button class="button button--primary" type="submit">{{ 'contact.submit' | t }}</button>
        </div>
      {% endform %}
    </div>
  </div>
</div>

{% stylesheet %}
  .contact {
    background-color: var(--color-background);
    color: var(--color-text);
  }

  .contact__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    max-width: 42rem;
    padding-block: var(--space-11) var(--space-20);
  }

  .contact__heading {
    font-size: var(--text-display-sm);
    line-height: 1.15;
  }

  .contact__intro {
    font-size: var(--text-body);
    line-height: 1.8;
  }

  .contact__form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
    padding-block-start: var(--space-3);
  }

  .contact__wide,
  .contact__form .callout,
  .contact__form .form-error-summary {
    grid-column: span 2;
  }

  @media screen and (max-width: 749px) {
    .contact__form {
      grid-template-columns: minmax(0, 1fr);
    }

    .contact__wide,
    .contact__form .callout,
    .contact__form .form-error-summary {
      grid-column: span 1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.contact_form",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "ground"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Write to us"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "t:labels.intro",
      "default": "<p>A person reads every message. We reply within two working days.</p>"
    }
  ],
  "presets": [
    {
      "name": "t:general.contact_form",
      "category": "t:general.cat_content"
    }
  ]
}
{% endschema %}
