{% comment %}
  A row of short columns -- the house services strip.

  https://shopify.dev/docs/storefronts/themes/architecture/sections
{% endcomment %}

<div class="columns color-{{ section.settings.color_scheme }} full-width">
  <div class="band">
    <div
      class="columns__inner section-padding"
      {% if settings.motion_reveal %}data-reveal{% endif %}
    >
      {%- if section.settings.heading != blank -%}
        <h2 class="eyebrow eyebrow--quiet">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      <ul class="columns__grid" style="--columns: {{ section.settings.columns }};">
        {%- for block in section.blocks -%}
          <li class="columns__item" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {% render 'image',
                image: block.settings.image,
                alt: block.settings.image_alt,
                ratio: 'media--wide',
                sizes: '(min-width: 750px) 25vw, 90vw',
                class: 'columns__media'
              %}
            {%- endif -%}
            <h3 class="columns__title">{{ block.settings.heading | escape }}</h3>
            <div class="columns__text rte">{{ block.settings.text }}</div>
            {%- if block.settings.link_label != blank -%}
              <a class="link-tap link-inline" href="{{ block.settings.link }}">
                {{- block.settings.link_label | escape -}}
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</div>

{% stylesheet %}
  .columns {
    background-color: var(--color-background);
    color: var(--color-text);
  }

  .columns__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .columns__grid {
    display: grid;
    grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
    gap: var(--space-11);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .columns__item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    min-width: 0;
    padding-block-start: var(--space-5);
    border-block-start: 1px solid var(--hairline-group);
  }

  .columns__media {
    margin-block-end: var(--space-2);
  }

  .columns__title {
    font-size: var(--text-title-sm);
    line-height: 1.25;
  }

  .columns__text {
    font-size: var(--text-detail);
    line-height: 1.75;
  }

  @media screen and (max-width: 749px) {
    .columns__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.multicolumn",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "ground"
    },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "House services" },
    {
      "type": "range",
      "id": "columns",
      "label": "t:labels.columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "t:general.column",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "t:labels.image" },
        {
          "type": "text",
          "id": "image_alt",
          "label": "t:labels.image_alt",
          "info": "t:info.image_alt"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "Resizing, for life"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:labels.text",
          "default": "<p>Free, up to three sizes either way, for as long as you own the piece.</p>"
        },
        { "type": "text", "id": "link_label", "label": "t:labels.link_label" },
        { "type": "url", "id": "link", "label": "t:labels.link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.preset_columns",
      "category": "t:general.cat_content",
      "blocks": [{ "type": "column" }, { "type": "column" }, { "type": "column" }]
    }
  ]
}
{% endschema %}
