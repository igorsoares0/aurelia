{% comment %}
  The bag, as a drawer. Rendered on every page but inert until opened.

  The whole drawer is one cart form, so the checkout button submits it and the
  drawer keeps working with JavaScript switched off -- the bag link in the
  header falls through to the cart page in that case.

  Quantity controls here are the full 44px, not the 36px the mock drew. A
  stepper is a control like any other and the touch-target floor applies to it.

  https://shopify.dev/docs/storefronts/themes/architecture/sections
{% endcomment %}

<aurelia-overlay id="CartDrawer" class="overlay overlay--end cart-drawer color-{{ section.settings.color_scheme }}">
  <button class="overlay__scrim" type="button" data-overlay-close>
    <span class="visually-hidden">{{ 'general.close' | t }}</span>
  </button>

  <div class="overlay__sheet" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle">
    <div data-cart-section="{{ section.id }}" class="cart-drawer__body">
      <div class="cart-drawer__head">
        <h2 class="eyebrow eyebrow--quiet cart-drawer__title" id="CartDrawerTitle">
          {%- if cart.item_count == 1 -%}
            {{ 'cart.title_count_one' | t }}
          {%- elsif cart.item_count > 1 -%}
            {{ 'cart.title_count_html' | t: count: cart.item_count }}
          {%- else -%}
            {{ 'cart.title' | t }}
          {%- endif -%}
        </h2>
        <button class="cart-drawer__close" type="button" data-overlay-close>
          <span class="visually-hidden">{{ 'general.close' | t }}</span>
          <span aria-hidden="true">&times;</span>
        </button>
      </div>

      {%- if cart.item_count == 0 -%}
        <div class="cart-drawer__empty">
          <p class="cart-drawer__empty-heading">{{ 'cart.empty_heading' | t }}</p>
          <p class="cart-drawer__empty-body">{{ 'cart.empty_body' | t }}</p>
          <a class="button button--secondary" href="{{ routes.all_products_collection_url }}">
            {{- 'cart.continue_shopping' | t -}}
          </a>
        </div>
      {%- else -%}
        <form class="cart-drawer__form" action="{{ routes.cart_url }}" method="post" novalidate>
          <aurelia-cart-items class="cart-drawer__scroll">
            <ul class="cart-drawer__list">
              {%- for item in cart.items -%}
                {%- liquid
                  assign line_alt = item.image.alt | default: item.product.title
                  assign line_qty_id = 'CartDrawerQuantity-' | append: forloop.index
                -%}
                <li class="cart-line">
                  {% render 'image',
                    image: item.image,
                    alt: line_alt,
                    ratio: 'media--tall',
                    sizes: '92px',
                    class: 'cart-line__media',
                    placeholder: 'product-1'
                  %}

                  <div class="cart-line__body">
                    <div class="cart-line__head">
                      <h3 class="cart-line__title">
                        <a href="{{ item.url }}">{{ item.product.title | escape }}</a>
                      </h3>
                      <span class="cart-line__price">
                        {%- if item.original_line_price > item.final_line_price -%}
                          <s class="cart-line__was">{{ item.original_line_price | money }}</s>
                        {%- endif -%}
                        {{ item.final_line_price | money }}
                      </span>
                    </div>

                    {%- if item.product.has_only_default_variant == false or item.properties.size > 0 -%}
                      <p class="cart-line__meta">
                        {%- unless item.product.has_only_default_variant -%}
                          {{ item.variant.title }}
                        {%- endunless -%}
                        {%- for property in item.properties -%}
                          {%- liquid
                            assign first_char = property.first | slice: 0
                            if first_char == '_' or property.last == blank
                              continue
                            endif
                          -%}
                          <span class="cart-line__property">
                            {{ property.first }}: {{ property.last }}
                          </span>
                        {%- endfor -%}
                      </p>
                    {%- endif -%}

                    {%- if item.selling_plan_allocation -%}
                      <p class="cart-line__meta">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                    {%- endif -%}

                    {%- if item.unit_price_measurement -%}
                      <p class="cart-line__meta">
                        {{ item.unit_price | money }}
                        <span aria-hidden="true">/</span>
                        {{ item.unit_price_measurement.reference_unit }}
                      </p>
                    {%- endif -%}

                    {%- if item.line_level_discount_allocations.size > 0 -%}
                      <ul class="cart-line__discounts">
                        {%- for allocation in item.line_level_discount_allocations -%}
                          <li>{{ allocation.discount_application.title }} (&minus;{{ allocation.amount | money }})</li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}

                    <div class="cart-line__actions">
                      {% render 'quantity-selector',
                        id: line_qty_id,
                        value: item.quantity,
                        name: 'updates[]',
                        title: item.product.title,
                        line: forloop.index,
                        min: 0
                      %}

                      <button
                        class="cart-line__remove"
                        type="button"
                        data-cart-remove="{{ forloop.index }}"
                      >
                        {{- 'cart.remove' | t -}}
                        <span class="visually-hidden">
                          {{- 'cart.remove_item' | t: title: item.product.title -}}
                        </span>
                      </button>
                    </div>
                  </div>
                </li>
              {%- endfor -%}
            </ul>

            {%- if section.settings.show_gift_note -%}
              <div class="field cart-drawer__note">
                <label class="field__label" for="CartDrawerNote">{{ 'cart.gift_note' | t }}</label>
                <textarea
                  class="field__textarea"
                  id="CartDrawerNote"
                  name="note"
                  rows="3"
                  placeholder="{{ 'cart.gift_note_placeholder' | t }}"
                >{{ cart.note }}</textarea>
              </div>
            {%- endif -%}
          </aurelia-cart-items>

          <div class="cart-drawer__foot">
            {% render 'cart-summary' %}
            {%- if section.settings.footnote != blank -%}
              <p class="cart-drawer__footnote">{{ section.settings.footnote | escape }}</p>
            {%- endif -%}
          </div>
        </form>
      {%- endif -%}
    </div>
  </div>
</aurelia-overlay>

{% stylesheet %}
  .cart-drawer .overlay__sheet {
    width: min(28.25rem, 100vw);
  }

  .cart-drawer__body {
    display: flex;
    flex-direction: column;
    min-height: 0;
    height: 100%;
  }

  .cart-drawer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-6) var(--space-4);
    border-block-end: 1px solid var(--hairline-section);
  }

  .cart-drawer__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--tap-target);
    min-height: var(--tap-target);
    font-size: var(--text-title-sm);
    color: var(--color-heading);
  }

  .cart-drawer__form {
    display: flex;
    flex-direction: column;
    min-height: 0;
    flex: 1;
  }

  .cart-drawer__scroll {
    display: block;
    flex: 1;
    overflow-y: auto;
    padding-inline: var(--space-6);
  }

  .cart-drawer__list {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .cart-line {
    display: grid;
    grid-template-columns: 92px minmax(0, 1fr);
    gap: var(--space-5);
    padding-block: var(--space-6);
    border-block-end: 1px solid var(--hairline-row);
  }

  .cart-line__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }

  .cart-line__head {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .cart-line__title {
    font-size: var(--text-title-sm);
    line-height: 1.2;
  }

  .cart-line__title a {
    text-decoration: none;
  }

  .cart-line__price {
    font-size: var(--text-detail);
    white-space: nowrap;
    color: var(--color-heading);
  }

  .cart-line__was {
    margin-inline-end: var(--space-1);
    color: var(--color-secondary);
  }

  .cart-line__meta,
  .cart-line__discounts {
    font-size: var(--text-caption);
    line-height: 1.6;
    color: var(--color-secondary);
  }

  .cart-line__discounts {
    padding-inline-start: var(--space-4);
    margin: 0;
    color: var(--color-accent);
  }

  .cart-line__property {
    display: block;
  }

  .cart-line__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block-start: var(--space-1);
  }

  .cart-line__remove {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
    font-size: var(--text-caption);
    text-decoration: underline;
    text-underline-offset: 0.25em;
    color: var(--color-secondary);
  }

  .cart-line__remove:hover {
    color: var(--color-heading);
  }

  .cart-drawer__note {
    padding-block: var(--space-5);
  }

  .cart-drawer__foot {
    padding: var(--space-5) var(--space-6) var(--space-6);
    border-block-start: 1px solid var(--hairline-section);
  }

  .cart-drawer__footnote {
    padding-block-start: var(--space-3);
    font-size: var(--text-caption);
    line-height: 1.7;
    text-align: center;
    color: var(--color-secondary);
  }

  .cart-drawer__empty {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-11) var(--space-6);
  }

  .cart-drawer__empty-heading {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: var(--text-title-lg);
    line-height: 1.2;
    color: var(--color-heading);
  }

  .cart-drawer__empty-body {
    font-size: var(--text-detail);
    color: var(--color-secondary);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.cart_drawer",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "ground"
    },
    {
      "type": "checkbox",
      "id": "show_gift_note",
      "label": "t:labels.show_gift_note",
      "default": true
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "t:labels.footnote",
      "default": "Shipping and tax are calculated at checkout."
    }
  ],
  "enabled_on": {
    "groups": ["aside"]
  }
}
{% endschema %}
