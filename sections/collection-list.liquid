{% comment %}
  A row of collections, each with its own count.

  https://shopify.dev/docs/storefronts/themes/architecture/sections
{% endcomment %}

{% render 'styles-collection-card' %}

<div class="chapters color-{{ section.settings.color_scheme }} full-width">
  <div class="band">
    <div
      class="chapters__inner section-padding"
      {% if settings.motion_reveal %}data-reveal{% endif %}
    >
      {%- if section.settings.heading != blank -%}
        <h2 class="eyebrow eyebrow--quiet">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      <ul class="chapters__grid" style="--columns: {{ section.settings.columns }};">
        {%- for block in section.blocks -%}
          {%- liquid
            assign chapter = block.settings.collection
            assign chapter_alt = chapter.featured_image.alt | default: chapter.title
            assign chapter_title = chapter.title
            if chapter_title == blank
              assign chapter_title = 'onboarding.collection_title' | t
            endif
          -%}
          <li class="collection-card" {{ block.shopify_attributes }}>
            {% render 'image',
              image: chapter.featured_image,
              alt: chapter_alt,
              height: section.settings.image_height,
              sizes: '(min-width: 750px) 45vw, 90vw',
              placeholder: 'collection-1'
            %}
            <div class="collection-card__caption">
              <h3 class="collection-card__title">
                <a class="collection-card__link" href="{{ chapter.url | default: routes.all_products_collection_url }}">
                  {{- chapter_title | escape -}}
                </a>
              </h3>
              {%- if section.settings.show_count and chapter != blank -%}
                <p class="collection-card__count">
                  {%- if chapter.all_products_count == 1 -%}
                    {{ 'collections.product_count_one' | t }}
                  {%- else -%}
                    {{ 'collections.product_count' | t: count: chapter.all_products_count }}
                  {%- endif -%}
                </p>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</div>

{% stylesheet %}
  .chapters {
    background-color: var(--color-background);
    color: var(--color-text);
  }

  .chapters__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .chapters__grid {
    display: grid;
    grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
    gap: var(--space-8);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  @media screen and (max-width: 749px) {
    .chapters__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection_list",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "ground"
    },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "The chapters" },
    {
      "type": "range",
      "id": "columns",
      "label": "t:labels.columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "t:labels.image_height",
      "min": 200,
      "max": 500,
      "step": 20,
      "unit": "px",
      "default": 300
    },
    { "type": "checkbox", "id": "show_count", "label": "t:labels.show_count", "default": true }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "t:general.collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "t:labels.collection" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.collection_list",
      "category": "t:general.cat_product",
      "blocks": [{ "type": "collection" }, { "type": "collection" }]
    }
  ]
}
{% endschema %}
