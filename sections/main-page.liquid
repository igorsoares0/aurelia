{% comment %}
  A content page, in two layouts: plain, and with an index down the side built
  from the headings in the page content.

  The index is generated by script from the real `<h2>` elements, so it can
  never list a section that is not there. Without script the page reads as an
  ordinary article, which is what it is.

  https://shopify.dev/docs/storefronts/themes/architecture/sections
{% endcomment %}

{% liquid
  assign with_index = false
  if section.settings.layout == 'page--index'
    assign with_index = true
  endif
%}

<div class="page-section {{ section.settings.layout }} color-{{ section.settings.color_scheme }} full-width">
  <div class="band">
    <aurelia-page-index class="page-section__inner">
      {%- if with_index -%}
        <nav class="page-section__index" aria-label="{{ 'general.on_this_page' | t }}" data-page-index hidden>
          <ul class="page-section__index-list" data-page-index-list></ul>
        </nav>
      {%- endif -%}

      <article class="page-section__article">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow eyebrow--wide">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h1 class="page-section__title">{{ page.title | escape }}</h1>
        <div class="page-section__content rte" data-page-content>{{ page.content }}</div>
      </article>
    </aurelia-page-index>
  </div>
</div>

{% stylesheet %}
  .page-section {
    background-color: var(--color-background);
    color: var(--color-text);
  }

  .page-section__inner {
    display: block;
    padding-block: var(--space-11) var(--space-20);
  }

  .page--index .page-section__inner {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: var(--space-11);
    align-items: start;
  }

  .page-section__index {
    position: sticky;
    top: var(--space-5);
    padding-inline-start: var(--space-4);
    border-inline-start: 1px solid var(--hairline-group);
  }

  .page-section__index-list {
    display: flex;
    flex-direction: column;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .page-section__index-list a {
    display: flex;
    align-items: center;
    min-height: var(--tap-target);
    font-size: var(--text-caption);
    line-height: 1.4;
    text-decoration: none;
    color: var(--color-secondary);
  }

  .page-section__index-list a[aria-current='true'] {
    color: var(--color-heading);
  }

  .page-section__article {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-width: 0;
  }

  .page-section__title {
    font-size: var(--text-display-md);
    line-height: 1.1;
  }

  .page-section__content {
    max-width: 68ch;
    font-size: var(--text-body-md);
    line-height: 1.85;
  }

  @media screen and (max-width: 989px) {
    .page--index .page-section__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }

    .page-section__index {
      position: static;
    }
  }
{% endstylesheet %}

{% javascript %}
  class AureliaPageIndex extends HTMLElement {
    connectedCallback() {
      const nav = this.querySelector('[data-page-index]');
      const list = this.querySelector('[data-page-index-list]');
      const content = this.querySelector('[data-page-content]');
      if (!nav || !list || !content) return;

      const headings = Array.from(content.querySelectorAll('h2'));
      if (headings.length < 2) return;

      headings.forEach((heading, index) => {
        if (!heading.id) heading.id = `page-section-${index + 1}`;

        const item = document.createElement('li');
        const link = document.createElement('a');
        link.href = `#${heading.id}`;
        link.textContent = heading.textContent;
        item.appendChild(link);
        list.appendChild(item);
      });

      nav.hidden = false;

      if (!('IntersectionObserver' in window)) return;

      const links = Array.from(list.querySelectorAll('a'));
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            links.forEach((link) => link.removeAttribute('aria-current'));
            const active = links.find((link) => link.hash === `#${entry.target.id}`);
            if (active) active.setAttribute('aria-current', 'true');
          });
        },
        { rootMargin: '0px 0px -70% 0px' }
      );

      headings.forEach((heading) => observer.observe(heading));
    }
  }

  if (!customElements.get('aurelia-page-index')) {
    customElements.define('aurelia-page-index', AureliaPageIndex);
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:general.page",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "ground"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:labels.layout",
      "options": [
        { "value": "page--plain", "label": "t:options.layout.plain" },
        { "value": "page--index", "label": "t:options.layout.index" }
      ],
      "default": "page--plain"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow"
    }
  ],
  "enabled_on": {
    "templates": ["page"]
  }
}
{% endschema %}
