{% comment %}
  The chapter: a heading row with a "view all" link, then a grid of pieces.

  The heading here is a tracked uppercase label rather than a display headline.
  A section that sits under a 72px statement does not need a second large
  headline competing with it -- the grid is the content, and the label just
  names it.

  https://shopify.dev/docs/storefronts/themes/architecture/sections
{% endcomment %}

{% liquid
  assign target = section.settings.collection
  assign count = section.settings.products_count
  assign columns = section.settings.columns
%}

<div class="chapter color-{{ section.settings.color_scheme }} full-width">
  <div class="band">
    <div
      class="chapter__inner section-padding"
      {% if settings.motion_reveal %}data-reveal{% endif %}
    >
      <div class="chapter__head">
        <h2 class="chapter__heading">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.link_label != blank -%}
          <a class="chapter__view-all" href="{{ target.url | default: routes.all_products_collection_url }}">
            {{- section.settings.link_label | escape -}}
            <span aria-hidden="true">&rarr;</span>
          </a>
        {%- endif -%}
      </div>

      <ul class="chapter__grid" style="--columns: {{ columns }};">
        {%- for product in target.products limit: count -%}
          {%- liquid
            assign card_loading = 'lazy'
            if forloop.index <= columns
              assign card_loading = 'eager'
            endif
          -%}
          <li>
            {% render 'product-card',
              product: product,
              number: forloop.index,
              image_height: section.settings.image_height,
              loading: card_loading,
              sizes: '(min-width: 990px) 30vw, 45vw'
            %}
          </li>
        {%- else -%}
          {%- comment -%}
            A preset has to render something before a merchant picks a
            collection, or the theme editor shows an empty band.
          {%- endcomment -%}
          {%- for index in (1..columns) -%}
            <li>
              <div class="card">
                <div class="media media--fixed" style="--media-height: {{ section.settings.image_height }}px;">
                  {{ 'product-1' | placeholder_svg_tag: 'media__placeholder' }}
                </div>
                <div class="card__body">
                  <h3 class="card__title">{{ 'onboarding.product_title' | t }}</h3>
                </div>
              </div>
            </li>
          {%- endfor -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
</div>

{% stylesheet %}
  .chapter {
    background-color: var(--color-background);
    color: var(--color-text);
  }

  .chapter__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-11);
  }

  .chapter__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-6);
    padding-block-end: var(--space-5);
    border-block-end: 1px solid var(--hairline-section);
  }

  /* A label, not a display headline: the statement above already carries one. */
  .chapter__heading {
    font-family: var(--font-body--family);
    font-size: var(--text-caption);
    font-weight: var(--font-body--weight-medium);
    line-height: 1;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-heading);
  }

  .chapter__view-all {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap-target);
    font-size: var(--text-label);
    font-weight: var(--font-body--weight-medium);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }

  .chapter__grid {
    display: grid;
    grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
    gap: var(--space-13) var(--space-9);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  @media screen and (max-width: 749px) {
    .chapter__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-8) var(--space-4);
    }

    .chapter__inner {
      gap: var(--space-8);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.featured_collection",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "ground"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:labels.collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "The autumn chapter"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:labels.link_label",
      "default": "View all"
    },
    {
      "type": "range",
      "id": "products_count",
      "label": "t:labels.products",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:labels.columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "t:labels.image_height",
      "min": 200,
      "max": 600,
      "step": 20,
      "unit": "px",
      "default": 420
    }
  ],
  "presets": [
    {
      "name": "t:general.featured_collection",
      "category": "t:general.cat_product"
    }
  ]
}
{% endschema %}
