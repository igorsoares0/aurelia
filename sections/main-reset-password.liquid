{% comment %}
  Choose a new password, reached from the link in a reset email.

  https://shopify.dev/docs/storefronts/themes/architecture/sections
{% endcomment %}

{% render 'styles-account' %}

<div class="account-page color-{{ section.settings.color_scheme }} full-width">
  <div class="band">
    <div class="account-page__narrow">
      <div class="account-page__panel">
        <h1 class="account-page__title">{{ 'customers.reset.title' | t }}</h1>

        {% form 'reset_customer_password', class: 'account-form', novalidate: 'novalidate' %}
          {%- if form.errors -%}
            <div class="form-error-summary" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <div class="field">
            <label class="field__label" for="ResetPassword">{{ 'customers.reset.password' | t }}</label>
            <input
              class="field__input"
              id="ResetPassword"
              type="password"
              name="customer[password]"
              autocomplete="new-password"
              required
              aria-describedby="ResetPasswordHelp"
              {% if form.errors %}aria-invalid="true"{% endif %}
            >
            <p class="account-page__help" id="ResetPasswordHelp">
              {{ 'customers.register.password_help' | t }}
            </p>
          </div>

          <div class="field">
            <label class="field__label" for="ResetPasswordConfirm">
              {{- 'customers.reset.password_confirm' | t -}}
            </label>
            <input
              class="field__input"
              id="ResetPasswordConfirm"
              type="password"
              name="customer[password_confirmation]"
              autocomplete="new-password"
              required
              {% if form.errors %}aria-invalid="true"{% endif %}
            >
          </div>

          <button class="button button--primary" type="submit">{{ 'customers.reset.submit' | t }}</button>
        {% endform %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:general.reset_password",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "ground"
    }
  ],
  "enabled_on": {
    "templates": ["customers/reset_password"]
  }
}
{% endschema %}
