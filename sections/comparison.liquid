{% comment %}
  Material against material -- 18k gold, vermeil, silver -- on the handful of
  questions a customer asks before choosing.

  It shares the ruled term-and-value treatment with the product specification
  ledger through `styles-ledger`. The two never render on the same page, so the
  rules cannot live in either file alone.

  The content is written once in the schema and rendered twice: a real table
  above the tablet breakpoint, one list per material below it. Restyling a
  single table instead would be cheaper and wrong -- changing `display` on a
  table drops its role and its `scope` associations in every major browser, and
  CSS cannot put them back. Only one of the two is ever in the accessibility
  tree, so nothing is announced twice.

  `{{ block.shopify_attributes }}` is on the table copy only; repeating it would
  emit duplicate editor ids. Block highlighting therefore works at desktop
  preview width, which is the right side of that trade.

  https://shopify.dev/docs/storefronts/themes/architecture/sections
{% endcomment %}

{% render 'styles-ledger' %}

{% liquid
  assign columns = section.blocks | where: 'type', 'column'
  assign rows = section.blocks | where: 'type', 'row'
%}

<div class="materials color-{{ section.settings.color_scheme }} full-width">
  <div class="band">
    <div
      class="materials__inner section-padding"
      {% if settings.motion_reveal %}data-reveal{% endif %}
    >
      {%- if section.settings.heading != blank -%}
        <h2 class="materials__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if columns.size > 0 and rows.size > 0 -%}
        <table class="materials__table">
          {%- if section.settings.table_caption != blank -%}
            <caption class="visually-hidden">{{ section.settings.table_caption | escape }}</caption>
          {%- endif -%}
          <thead>
            <tr>
              <th class="materials__corner" scope="col">
                <span class="visually-hidden">{{ 'comparison.criterion' | t }}</span>
              </th>
              {%- for column in columns -%}
                <th class="materials__col" scope="col" {{ column.shopify_attributes }}>
                  <span class="materials__col-title">{{ column.settings.title | escape }}</span>
                  {%- if column.settings.note != blank -%}
                    <span class="materials__col-note">{{ column.settings.note | escape }}</span>
                  {%- endif -%}
                </th>
              {%- endfor -%}
            </tr>
          </thead>
          <tbody>
            {%- for row in rows -%}
              <tr {{ row.shopify_attributes }}>
                <th class="ledger__term" scope="row">{{ row.settings.label | escape }}</th>
                {%- for column in columns -%}
                  {%- liquid
                    assign value_key = 'value_' | append: forloop.index
                    assign cell = row.settings[value_key]
                  -%}
                  <td class="ledger__value">
                    {%- if cell != blank -%}
                      {{- cell | escape -}}
                    {%- else -%}
                      <span class="visually-hidden">{{ 'comparison.not_specified' | t }}</span>
                      <span aria-hidden="true">&mdash;</span>
                    {%- endif -%}
                  </td>
                {%- endfor -%}
              </tr>
            {%- endfor -%}
          </tbody>
        </table>

        <div class="materials__lists">
          {%- for column in columns -%}
            {%- assign value_key = 'value_' | append: forloop.index -%}
            <div class="materials__card">
              <h3 class="materials__card-title">{{ column.settings.title | escape }}</h3>
              {%- if column.settings.note != blank -%}
                <p class="materials__card-note detail">{{ column.settings.note | escape }}</p>
              {%- endif -%}
              <dl class="materials__ledger">
                {%- for row in rows -%}
                  <dt class="ledger__term">{{ row.settings.label | escape }}</dt>
                  <dd class="ledger__value">
                    {%- assign cell = row.settings[value_key] -%}
                    {%- if cell != blank -%}
                      {{- cell | escape -}}
                    {%- else -%}
                      <span class="visually-hidden">{{ 'comparison.not_specified' | t }}</span>
                      <span aria-hidden="true">&mdash;</span>
                    {%- endif -%}
                  </dd>
                {%- endfor -%}
              </dl>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.note != blank -%}
        <div class="materials__note rte measure-body">{{ section.settings.note }}</div>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .materials {
    background-color: var(--color-background);
    color: var(--color-text);
  }

  .materials__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .materials__heading {
    font-size: var(--text-display-sm);
    line-height: var(--leading-heading);
  }

  /* The stacked lists are the base state, so a print context -- which matches
     no `screen` query -- still gets exactly one of the two structures. */
  .materials__table {
    display: none;
  }

  .materials__lists {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-11);
  }

  .materials__card {
    padding-block-start: var(--space-5);
    border-block-start: 1px solid var(--hairline-strong);
  }

  .materials__card-title {
    font-size: var(--text-title);
    line-height: var(--leading-title);
  }

  .materials__card-note {
    margin-block-start: var(--space-1);
    color: var(--color-secondary);
  }

  .materials__ledger {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0;
    margin-block-start: var(--space-4);
  }

  .materials__corner,
  .materials__col {
    padding-block-end: var(--space-3);
    border-block-end: 1.5px solid var(--color-heading);
    text-align: start;
    vertical-align: bottom;
  }

  .materials__col {
    padding-inline-end: var(--space-6);
  }

  .materials__col-title {
    display: block;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: var(--text-title-sm);
    line-height: var(--leading-title);
    color: var(--color-heading);
  }

  .materials__col-note {
    display: block;
    margin-block-start: var(--space-1);
    font-size: var(--text-caption);
    color: var(--color-secondary);
  }

  .materials__table .ledger__value {
    padding-inline-end: var(--space-6);
    vertical-align: top;
  }

  .materials__note {
    font-size: var(--text-detail);
    color: var(--color-secondary);
  }

  @media screen and (min-width: 990px) {
    /* Restructured: above the tablet breakpoint the comparison is a table, and
       the per-material lists leave the accessibility tree entirely. */
    .materials__table {
      display: table;
      width: 100%;
      table-layout: fixed;
    }

    .materials__lists {
      display: none;
    }
  }

  @media print {
    /* Neither `screen` query matches here, so the table has to be named again
       or the page would print the stacked lists. */
    .materials__table {
      display: table;
      width: 100%;
      table-layout: fixed;
    }

    .materials__lists {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.comparison",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "ground"
    },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Gold, vermeil, silver" },
    {
      "type": "text",
      "id": "table_caption",
      "label": "t:labels.table_caption",
      "info": "t:info.table_caption",
      "default": "Materials compared on wear, skin, care and price"
    },
    {
      "type": "richtext",
      "id": "note",
      "label": "t:labels.note",
      "default": "<p>Every piece can be remade in any of the three. Ask, and we quote before we start.</p>"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "t:general.material",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "t:labels.name", "default": "18k recycled gold" },
        { "type": "text", "id": "note", "label": "t:labels.note", "default": "The house standard" }
      ]
    },
    {
      "type": "row",
      "name": "t:general.row",
      "settings": [
        { "type": "text", "id": "label", "label": "t:labels.spec_term", "default": "Wears" },
        {
          "type": "text",
          "id": "value_1",
          "label": "t:labels.value_1",
          "info": "t:info.comparison_values",
          "default": "A lifetime"
        },
        { "type": "text", "id": "value_2", "label": "t:labels.value_2", "default": "Two to five years" },
        { "type": "text", "id": "value_3", "label": "t:labels.value_3", "default": "A lifetime, with polishing" },
        { "type": "text", "id": "value_4", "label": "t:labels.value_4" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.preset_materials",
      "category": "t:general.cat_product",
      "blocks": [
        { "type": "column" },
        { "type": "column" },
        { "type": "column" },
        { "type": "row" },
        { "type": "row" },
        { "type": "row" },
        { "type": "row" }
      ]
    }
  ]
}
{% endschema %}
