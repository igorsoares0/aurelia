{% comment %}
  The statement: an eyebrow, a display headline, and a short lead, centred and
  given a great deal of room.

  The headline's measure is set in `em` of its own size, not in `ch`. A `ch`
  unit resolves against the inherited body font, so a headline constrained that
  way changes width whenever a merchant swaps the body face -- which is exactly
  when you least want the line breaks to move.

  https://shopify.dev/docs/storefronts/themes/architecture/sections
{% endcomment %}

<div class="statement color-{{ section.settings.color_scheme }} full-width">
  <div class="band">
    <div
      class="statement__inner statement__inner--{{ section.settings.alignment }} section-padding--statement"
      {% if settings.motion_reveal %}data-reveal{% endif %}
    >
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'eyebrow' -%}
            <p class="eyebrow eyebrow--wide" {{ block.shopify_attributes }}>
              {{- block.settings.text | escape -}}
            </p>

          {%- when 'heading' -%}
            <h2 class="statement__heading measure-display" {{ block.shopify_attributes }}>
              {{- block.settings.text -}}
            </h2>

          {%- when 'text' -%}
            <div class="statement__lead lead measure-lead rte" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </div>

          {%- when 'button' -%}
            {%- if block.settings.label != blank -%}
              <a
                class="button button--secondary"
                href="{{ block.settings.link | default: routes.all_products_collection_url }}"
                {{ block.shopify_attributes }}
              >
                {{- block.settings.label | escape -}}
              </a>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .statement {
    background-color: var(--color-background);
    color: var(--color-text);
  }

  .statement__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    max-width: 62.5rem;
  }

  .statement__inner--center {
    align-items: center;
    margin-inline: auto;
    text-align: center;
  }

  .statement__inner--left {
    align-items: flex-start;
  }

  .statement__heading {
    font-size: var(--text-display-3xl);
    line-height: var(--leading-display);
    letter-spacing: -0.01em;
  }

  .statement__heading em {
    display: block;
  }

  .statement__lead {
    font-size: var(--text-lead);
    line-height: var(--leading-lead);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.rich_text",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "ground"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:labels.alignment",
      "options": [
        { "value": "center", "label": "t:options.alignment.center" },
        { "value": "left", "label": "t:options.alignment.left" }
      ],
      "default": "center"
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "t:labels.eyebrow",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:labels.text",
          "default": "Chapter one"
        }
      ]
    },
    {
      "type": "heading",
      "name": "t:general.heading",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "t:labels.heading",
          "info": "t:info.statement_heading",
          "default": "<p>Twelve pieces a year.<em>Each one kept forever.</em></p>"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:general.text",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "t:labels.text",
          "default": "<p>Made at the bench in Belo Horizonte, in 18k recycled gold. Twenty-one days from order to shipping, and free resizing for life.</p>"
        }
      ]
    },
    {
      "type": "button",
      "name": "t:general.button",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:labels.button_label",
          "default": "Shop the chapter"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:labels.button_link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.preset_statement",
      "category": "t:general.cat_content",
      "blocks": [
        { "type": "eyebrow" },
        { "type": "heading" },
        { "type": "text" }
      ]
    }
  ]
}
{% endschema %}
