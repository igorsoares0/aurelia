{% comment %}
  A film beside a passage of text, or running full width above it.

  There is no autoplay setting. The film starts because someone pressed play,
  and until then nothing of it is fetched -- see `video-facade` for the swap.
  That is the theme's rule, not a limitation: a video that starts itself is on
  the short list of things this house does not do.

  https://shopify.dev/docs/storefronts/themes/architecture/sections
{% endcomment %}

{% liquid
  assign layout = section.settings.layout
  assign alt = section.settings.image_alt | default: section.settings.heading
%}

<div class="film color-{{ section.settings.color_scheme }} full-width">
  <div class="band">
    {%- if layout == 'film__inner--full' -%}
      <aurelia-video
        class="film__media film__media--bleed full-width"
        style="--film-height: {{ section.settings.video_height }}px;"
        data-video-label="{{ alt | escape }}"
      >
        {% render 'video-facade',
          video: section.settings.video,
          video_url: section.settings.video_url,
          poster: section.settings.poster,
          alt: alt,
          height: section.settings.video_height,
          sizes: '100vw'
        %}
      </aurelia-video>
    {%- endif -%}

    <div
      class="film__inner {{ layout }} section-padding"
      {% if settings.motion_reveal %}data-reveal{% endif %}
    >
      {%- unless layout == 'film__inner--full' -%}
        <aurelia-video
          class="film__media"
          style="--film-height: {{ section.settings.video_height }}px;"
          data-video-label="{{ alt | escape }}"
        >
          {% render 'video-facade',
            video: section.settings.video,
            video_url: section.settings.video_url,
            poster: section.settings.poster,
            alt: alt,
            height: section.settings.video_height,
            sizes: '(min-width: 990px) 50vw, 100vw'
          %}
        </aurelia-video>
      {%- endunless -%}

      <div class="film__text">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow eyebrow--wide">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="film__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        <div class="film__body rte measure-lead">{{ section.settings.text }}</div>

        {%- if section.settings.button_label != blank -%}
          <a class="button button--secondary" href="{{ section.settings.button_link }}">
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<script src="{{ 'video.js' | asset_url }}" defer="defer"></script>

{% stylesheet %}
  .film {
    background-color: var(--color-background);
    color: var(--color-text);
  }

  .film__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: var(--space-18);
    align-items: center;
  }

  .film__inner--right .film__media {
    order: 2;
  }

  .film__inner--full {
    display: block;
    padding-block-start: var(--space-8);
  }

  .film__media {
    position: relative;
    display: block;
    min-width: 0;
  }

  .film__play {
    position: absolute;
    inset-block-end: var(--space-4);
    inset-inline-start: var(--space-4);
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    justify-content: center;
    min-width: var(--tap-target);
    min-height: var(--tap-target);
    padding-inline: var(--space-4);
    border: 1px solid var(--hairline-control);
    background-color: var(--color-background);
    font-size: var(--text-label);
    text-decoration: none;
    color: var(--color-heading);
    transition: color var(--motion-hover) ease, border-color var(--motion-hover) ease;
  }

  .film__play:hover {
    border-color: var(--color-heading);
    color: var(--color-accent);
  }

  .film__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
    min-width: 0;
  }

  .film__inner--full .film__text {
    margin-block-start: var(--space-8);
  }

  .film__heading {
    font-size: var(--text-display-sm);
    line-height: var(--leading-heading);
  }

  .film__body {
    font-size: var(--text-lead);
    line-height: var(--leading-lead);
  }

  @media screen and (max-width: 989px) {
    /* Restructured: film over text, not two narrow columns. */
    .film__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-8);
    }

    .film__inner--right .film__media {
      order: 0;
    }
  }

  @media screen and (max-width: 749px) {
    /* A film sized for a desktop column would fill a phone screen end to end. */
    .film__media .film__poster {
      height: min(var(--film-height), 62vh);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.video_with_text",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "ground"
    },
    { "type": "video", "id": "video", "label": "t:labels.video", "info": "t:info.video_policy" },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "t:labels.video_url",
      "info": "t:info.video_url",
      "accept": ["youtube", "vimeo"],
      "placeholder": "https://www.youtube.com/watch?v="
    },
    { "type": "image_picker", "id": "poster", "label": "t:labels.poster", "info": "t:info.poster" },
    {
      "type": "text",
      "id": "image_alt",
      "label": "t:labels.image_alt",
      "info": "t:info.image_alt",
      "default": "The bench in Belo Horizonte"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:labels.layout",
      "options": [
        { "value": "film__inner--left", "label": "t:options.layout.media_left" },
        { "value": "film__inner--right", "label": "t:options.layout.media_right" },
        { "value": "film__inner--full", "label": "t:options.layout.full" }
      ],
      "default": "film__inner--left"
    },
    {
      "type": "range",
      "id": "video_height",
      "label": "t:labels.video_height",
      "min": 320,
      "max": 760,
      "step": 20,
      "unit": "px",
      "default": 520
    },
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "The film" },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Twenty-one days, in four minutes"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.body_text",
      "default": "<p>Filmed at the bench over one chapter. No music, no narration, only the work.</p>"
    },
    { "type": "text", "id": "button_label", "label": "t:labels.button_label" },
    { "type": "url", "id": "button_link", "label": "t:labels.button_link" }
  ],
  "presets": [
    { "name": "t:general.preset_screening", "category": "t:general.cat_media" }
  ]
}
{% endschema %}
