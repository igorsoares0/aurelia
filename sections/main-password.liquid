{% comment %}
  The password page, shown while a store is not yet open.

  The newsletter is the primary action; the password entry is folded into a
  `<details>` because it is for staff, not for the people the page is written
  for. That ordering is the whole point of the design.

  https://shopify.dev/docs/storefronts/themes/architecture/sections
{% endcomment %}

<div class="password color-{{ section.settings.color_scheme }} full-width">
  {%- if section.settings.image != blank -%}
    <div class="password__backdrop" aria-hidden="true">
      {% render 'image',
        image: section.settings.image,
        alt: '',
        ratio: 'media--natural',
        sizes: '100vw',
        loading: 'eager',
        fetchpriority: 'high',
        class: 'password__image'
      %}
      <div class="password__wash"></div>
    </div>
  {%- endif -%}

  <main class="password__inner" id="MainContent">
    <div class="password__top">
      <p class="password__wordmark">{{ shop.name }}</p>
    </div>

    <div class="password__body">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow eyebrow--wide">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      <h1 class="password__title">{{ section.settings.heading | escape }}</h1>

      {%- if shop.password_message != blank -%}
        <div class="password__message rte">{{ shop.password_message }}</div>
      {%- elsif section.settings.body != blank -%}
        <div class="password__message rte">{{ section.settings.body }}</div>
      {%- endif -%}

      {% render 'newsletter-form',
        id: 'PasswordNewsletter',
        note: section.settings.newsletter_note,
        class: 'password__newsletter'
      %}
    </div>

    <details class="password__staff">
      <summary class="password__summary">{{ 'password.login_summary' | t }}</summary>

      {% form 'storefront_password', class: 'password__form' %}
        {%- if form.errors -%}
          <p class="field__error" role="alert">
            <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
            {{ 'password.error' | t }}
          </p>
        {%- endif -%}

        <div class="field">
          <label class="field__label" for="StorefrontPassword">{{ 'password.password' | t }}</label>
          <input
            class="field__input"
            id="StorefrontPassword"
            type="password"
            name="password"
            autocomplete="current-password"
            {% if form.errors %}aria-invalid="true"{% endif %}
          >
        </div>

        <button class="button button--secondary" type="submit">{{ 'password.enter' | t }}</button>
      {% endform %}
    </details>
  </main>
</div>

{% stylesheet %}
  .password {
    position: relative;
    display: block;
    min-height: 100svh;
    background-color: var(--color-background);
    color: var(--color-text);
  }

  .password__backdrop {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .password__image {
    height: 100%;
  }

  .password__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .password__wash {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgb(var(--hairline-rgb) / 82%) 0%,
      rgb(var(--hairline-rgb) / 50%) 55%,
      rgb(var(--hairline-rgb) / 16%) 100%
    );
  }

  .password__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-8);
    min-height: 100svh;
    max-width: 33rem;
    padding: var(--space-13) var(--page-margin);
  }

  .password__wordmark {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: var(--text-title-lg);
    line-height: 1;
    letter-spacing: 0.32em;
    text-indent: 0.32em;
    text-transform: uppercase;
    color: var(--color-heading);
  }

  .password__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .password__title {
    font-size: var(--text-display-lg);
    line-height: 1.06;
  }

  .password__message {
    max-width: 25rem;
    font-size: var(--text-body-md);
    line-height: 1.75;
  }

  .password__newsletter {
    padding-block-start: var(--space-3);
  }

  .password__staff {
    padding-block-start: var(--space-5);
    border-block-start: 1px solid var(--hairline-quiet);
  }

  .password__summary {
    display: flex;
    align-items: center;
    min-height: var(--tap-target);
    font-size: var(--text-detail);
    color: var(--color-text);
    cursor: pointer;
  }

  .password__form {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    padding-block-start: var(--space-4);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.password",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "ink"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.background_image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Opening this autumn"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Twelve pieces a year. Each one kept forever."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:labels.text",
      "default": "<p>A jewellery house in Belo Horizonte, working in 18k recycled gold. The first chapter opens shortly.</p>"
    },
    {
      "type": "text",
      "id": "newsletter_note",
      "label": "t:labels.note",
      "default": "One letter when the doors open."
    }
  ]
}
{% endschema %}
